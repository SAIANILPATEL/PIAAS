            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import java.io.FileWriter;
import java.io.PrintWriter;
// Define the file path
String filePath = &quot;Acc_Req_Data.csv&quot;; // Update the file path as required
// Check if the assertion passed
if (prev.isSuccessful()) {
    // Retrieve variables
    String requisitionID = vars.get(&quot;C_requisition_id&quot;);
        // Check if C_requisition_id is valid and not &quot;C_requisition_id_NA&quot;
    if (requisitionID != null &amp;&amp; !requisitionID.isEmpty() &amp;&amp; !&quot;C_requisition_id_NA&quot;.equals(requisitionID)) {
        // Append the requisition ID and customer name to the file
        PrintWriter writer = null;
        try {
            writer = new PrintWriter(new FileWriter(filePath, true));
            writer.println(requisitionID);
            log.info(&quot;Requisition ID written to file: &quot; + requisitionID);
        } catch (Exception e) {
            log.error(&quot;Error while writing to file: &quot; + e.getMessage());
        } finally {
            if (writer != null) {
                writer.close();
            }
        }
    } else {
        log.info(&quot;C_requisition_id not valid&quot;);
    }
} else {
    log.info(&quot;Assertion failed. Requisition ID not written to file.&quot;);
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
