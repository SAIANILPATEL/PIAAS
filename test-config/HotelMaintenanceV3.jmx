fragment MaintenanceRequestCodeStore on MaintenanceRequestCodes {
  entityId
  description
  code
  completionLevelId
  operationalDepartmentId
  operationalDepartmentGql(hierarchyId: $hierarchyId) @include(if: $withDepartment) {
    description
    __typename
  }
  level1MaintenanceTeamId
  level1MaintenanceTeamGql(hierarchyId: $hierarchyId) @include(if: $withLevel1Team) {
    description
    enabled
    deleted
    __typename
  }
  level2MaintenanceTeamId
  level2MaintenanceTeamGql(hierarchyId: $hierarchyId) @include(if: $withLevel2Team) {
    enabled
    deleted
    __typename
  }
  level3MaintenanceTeamId
  level3MaintenanceTeamGql(hierarchyId: $hierarchyId) @include(if: $withLevel3Team) {
    enabled
    deleted
    __typename
  }
  suggestedServiceRequestCodeId
  source
  externalCode
  suggestedCleaningTaskCodeId
  suggestedCleaningTaskCodeGql(hierarchyId: $hierarchyId) @include(if: $withCleaningTaskCode) {
    description
    __typename
  }
  housekeepingRequired
  ivrCode
  issueClassGql(hierarchyId: $hierarchyId) @include(if: $withIssueClass) {
    translations
    __typename
  }
  defaultPriorityGql(hierarchyId: $hierarchyId) @include(if: $withPriority) {
    code
    entityId
    translations
    __typename
  }
  completionLevelGql @include(if: $withLevel) {
    details {
      locationAreaClassId
      critical
      high
      medium
      low
      lowest
      __typename
    }
    __typename
  }
  deleted
  enabled
  __typename
}
