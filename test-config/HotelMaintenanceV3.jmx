    translations
    __typename
  }
  defaultPriorityGql(hierarchyId: $hierarchyId) @include(if: $withPriority) {
    code
    entityId
    translations
    __typename
  }
  completionLevelGql @include(if: $withLevel) {
    details {
      locationAreaClassId
      critical
      high
      medium
      low
      lowest
      __typename
    }
    __typename
  }
