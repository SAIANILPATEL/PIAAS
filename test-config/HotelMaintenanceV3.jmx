    }\n    statusMatch\n    translations\n    __typename\n  }\n  mainContactPerson {\n    cabin {\n      code\n      deck {\n        code\n        id\n        translations\n        __typename\n      }\n      housekeepingSection\n      id\n      __typename\n    }\n    cabinMissing\n    disembarkation {\n      actualDate\n      actualTime\n      actualVoyage {\n        id\n        port {\n          code\n          country {\n            code\n            flagId\n            id\n            iso2\n            iso3\n            translations\n            __typename\n          }\n          id\n          translations\n          __typename\n        }\n        seaDay\n        voyageDayDate\n        __typename\n      }\n      airport {\n        code\n        country {\n          code\n          flagId\n          id\n          iso2\n          iso3\n          translations\n          __typename\n        }\n        id\n        translations\n        __typename\n      }\n      displayDate\n      displayTime\n      displayVoyage {\n        id\n        port {\n          code\n          country {\n            code\n            flagId\n            id\n            iso2\n            iso3\n            translations\n            __typename\n          }\n          id\n          translations\n          __typename\n        }\n        seaDay\n        voyageDayDate\n        __typename\n      }\n      port {\n        code\n        country {\n          code\n          flagId\n          id\n          iso2\n          iso3\n          translations\n          __typename\n        }\n        id\n        translations\n        __typename\n      }\n      portMismatch\n      scheduledDate\n      scheduledVoyage {\n        id\n        port {\n          code\n          country {\n            code\n            flagId\n            id\n            iso2\n            iso3\n            translations\n            __typename\n          }\n          id\n          translations\n          __typename\n        }\n        sea