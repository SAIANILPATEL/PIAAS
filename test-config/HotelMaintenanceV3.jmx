              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument" enabled="true">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;GuestSearchList&quot;,&quot;variables&quot;:{&quot;withServiceItemRequestsInfo&quot;:false,&quot;withPersonSearchInfo&quot;:false,&quot;withLoyaltyProgramValueInfo&quot;:false,&quot;search&quot;:&quot;%28cabin.code%3D%3D%22%2a${P_HotelGuestName}%2a%22%20or%20firstNameLastName%3D%3D%22%2a${P_HotelGuestName}%2a%22%20or%20bookingNumber%3D%3D%22%2a${P_HotelGuestName}%2a%22%20or%20groups.code%3D%3D%22%2a${P_HotelGuestName}%2a%22%20or%20groups.description%3D%3D%22%2a${P_HotelGuestName}%2a%22%20or%20personDocuments.documentNr%3D%3D%22%2a${P_HotelGuestName}%2a%22%20or%20externalId%3D%3D%22%2a${P_HotelGuestName}%2a%22%29%20and%20accountType%3D%3DPAX%20and%20%28shipId%3D%3D${C_shipId}%29&quot;,&quot;page&quot;:0,&quot;size&quot;:25,&quot;hierarchyId&quot;:&quot;${C_shipId}&quot;},&quot;query&quot;:&quot;query GuestSearchList($search: String, $page: Int, $size: Int, $sort: String, $hierarchyId: String, $withServiceItemRequestsInfo: Boolean = false, $withPersonSearchInfo: Boolean = false, $withLoyaltyProgramValueInfo: Boolean = false) {\n  pageableAllReservationSearches(\n    search: $search\n    page: $page\n    size: $size\n    sort: $sort\n  ) {\n    totalElements\n    number\n    totalPages\n    content {\n      ...GuestSearch\n      __typename\n    }\n    __typename\n  }\n}\n\nfragment GuestSearch on AllReservationSearch {\n  absenceDetails {\n    absenceEndDate\n    absenceReason\n    absenceStartDate\n    absenceTourDescription\n    absenceTourId\n    currentlyAbsent\n    __typename\n  }\n  accountType\n  activeFrom\n  activeFromTime\n  activeTo\n  activeToTime\n  activityDetails {\n    participateInActivities\n    __typename\n  }\n  actualDisembarkationVoyageDayId\n  actualEmbarkationVoyageDayId\n  age\n  ageGroups {\n    category\n    group\n    __typename\n  }\n  allMemberCount\n  amountNeededToAuthorization\n  authorizationAmount {\n    totalApproveAmount\n    authorizationDetails {\n      approveAmount\n      authorizationStatus\n      authorizationType\n      creditCardType\n      creditCardTypeName\n      paymentAuthorizationId\n      paymentMethodMerchantId\n      paymentMethodTokenId\n      pspReference\n      subdepartmentEntityId\n      __typename\n    }\n    subDepartmentEntityId\n    totalApproveAmount\n    __typename\n  }\n  birthNationality {\n    code\n    flagId\n    id\n    iso2\n    iso3\n    translations\n    __typename\n  }\n  birthday\n  boardCardId\n  bookingNumber\n  cabin {\n    code\n    deck {\n      code\n      id\n      translations\n      __typename\n    }\n    housekeepingSection\n    id\n    __typename\n  }\n  classifications {\n    code\n    id\n    entityId\n    translations\n    __typename\n  }\n  company\n  creditBalance {\n    creditLimitDaily\n    creditLimitTotal\n    leftToSpendToday\n    leftToSpendTotal\n    limitForAllDepartments\n    __typename\n  }\n  crewId\n  currentBalance {\n    creditBalance\n    currentBalance\n    debitBalance\n    nonRefundable\n    packageBalance\n    remainingBalance\n    zeroBalanceAccount\n    zeroBalanceAccountWithoutTransactions\n    __typename\n  }\n  daysPassed\n  daysRemaining\n  disallowedDepartments {\n    code\n    id\n    subDepartments {\n      code\n      id\n      translations\n      __typename\n    }\n    translations\n    __typename\n  }\n  displayDisembarkationVoyageDayId\n  enabled\n  externalBoardcardId\n  firstName\n  global\n  goldenId\n  groupExternalCode\n  groups {\n    code\n    description\n    disallowedDepartments {\n      code\n      id\n      subDepartments {\n        code\n        id\n        translations\n        __typename\n      }\n      translations\n      __typename\n    }\n    groupEnabled\n    groupSize\n    id\n    profileGroupId\n    reservationStatus\n    role {\n      code\n      entityId\n      hierarchyId\n      id\n      translations\n      __typename\n    }\n    __typename\n  }\n  id\n  intoxicated\n  lastName\n  lateCheckout\n  loyaltyTiers {\n    awardedDate\n    code\n    cruiseLine\n    entityId\n    firstCruise\n    id\n    loyaltyMemberId\n    loyaltyMemberPoints\n    loyaltyProgramEntityId\n    loyaltyProgramId\n    loyaltyProgramValue @include(if: $withLoyaltyProgramValueInfo) {\n      id\n      cruiselineOwned\n      __typename\n    }\n    statusMatch\n    translations\n    __typename\n  }\n  mainContactPerson {\n    cabin {\n      code\n      deck {\n        code\n        id\n        translations\n        __typename\n      }\n      housekeepingSection\n      id\n      __typename\n    }\n    cabinMissing\n    disembarkation {\n      actualDate\n      actualTime\n      actualVoyage {\n        id\n        port {\n          code\n          country {\n            code\n            flagId\n            id\n            iso2\n            iso3\n            translations\n            __typename\n          }\n          id\n          translations\n          __typename\n        }\n        seaDay\n        voyageDayDate\n        __typename\n      }\n      airport {\n        code\n        country {\n          code\n          flagId\n          id\n          iso2\n          iso3\n          translations\n          __typename\n        }\n        id\n        translations\n        __typename\n      }\n      displayDate\n      displayTime\n      displayVoyage {\n        id\n        port {\n          code\n          country {\n            code\n            flagId\n            id\n            iso2\n            iso3\n            translations\n            __typename\n          }\n          id\n          translations\n          __typename\n        }\n        seaDay\n        voyageDayDate\n        __typename\n      }\n      port {\n        code\n        country {\n          code\n          flagId\n          id\n          iso2\n          iso3\n          translations\n          __typename\n        }\n        id\n        translations\n        __typename\n      }\n      portMismatch\n      scheduledDate\n      schedul