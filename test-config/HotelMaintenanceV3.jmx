            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
            <stringProp name="GraphQLHTTPSampler.operationName">MaintenanceRequestsOverview</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">query MaintenanceRequestsOverview($search: String, $page: Int, $size: Int, $sort: String) {
  pageablePersonMaintenanceRequests(
    search: $search
    page: $page
    size: $size
    sort: $sort
  ) {
    totalElements
    totalPages
    size
    content {
      ...MaintenanceRequestOverview
      __typename
    }
    __typename
  }
}

fragment MaintenanceRequestOverview on PersonMaintenanceRequest {
  id
  number
  cleaningLocationGql {
    description
    originalCabinGql {
      code
      cabinCategoryValue {
        translations
        __typename
      }
      cabinType
      __typename
    }
    originalLocationGql {
      translations
      locationTypesValue {
        translations
        __typename
      }
      __typename
    }
    __typename
  }
  activeMaintenanceTeamGql {
    description
    __typename
  }
  displayCompletion
  creationDTTMLocal
  maintenanceRequestCodeGql {
    description
    operationalDepartmentGql {
      description
      __typename
    }
    issueGroupGql {
      translations
      __typename
    }
    issueCategoryGql {
      translations
      __typename
    }
    hasGuestImpact
    __typename
  }
  assigneeReservation: assigneeGql {
    ...MaintenanceRequestReservation
    __typename
  }
  reportedByGql {
    ...MaintenanceRequestReservation
    __typename
  }
  priorityGql {
    translations
    __typename
  }
  statusGql {
    ...LookupValueStore
    __typename
  }
  statusDetailGql {
    description
    id
    __typename
  }
  causeGql {
    translations
    __typename
  }
  createdBy
  createdByGql {
    ...UserProfileData
    __typename
  }
  requestDetail
  __typename
}

fragment MaintenanceRequestReservation on PersonReservation {
  id
  accountType
  profile {
    firstName
    lastName
    __typename
  }
  __typename
}

fragment LookupValueStore on LookupValue {
  entityId
  translations
  code
  externalDescription
  enabled
  deleted
  __typename
}

fragment UserProfileData on User {
  id
  userProfile {
    id
    firstName
    lastName
    __typename
  }
  __typename
}
</stringProp>
