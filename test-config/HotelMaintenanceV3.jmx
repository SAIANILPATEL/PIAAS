\n  createdBy\n  createdByGql {\n    ...UserProfileData\n    __typename\n  }\n  requestDetail\n  __typename\n}\n\nfragment MaintenanceRequestReservation on PersonReservation {\n  id\n  accountType\n  profile {\n    firstName\n    lastName\n    __typename\n  }\n  __typename\n}\n\nfragment LookupValueStore on LookupValue {\n  entityId\n  translations\n  code\n  externalDescription\n  enabled\n  deleted\n  __typename\n}\n\nfragment UserProfileData on User {\n  id\n  userProfile {\n    id\n    firstName\n    lastName\n    __typename\n  }\n  __typename\n}&quot;}</stringProp>
