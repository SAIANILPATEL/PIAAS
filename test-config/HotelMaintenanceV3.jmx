                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;MaintenanceRequestsOverview&quot;,&quot;variables&quot;:{&quot;search&quot;:&quot;status.code%3Din%3D%28%22OPEN%22%2C%22IN-PROGRESS%22%29%20and%20shipId%3D%3D${C_shipId}&quot;,&quot;page&quot;:0,&quot;size&quot;:20,&quot;sort&quot;:&quot;number%2Cdesc&quot;},&quot;query&quot;:&quot;query MaintenanceRequestsOverview($search: String, $page: Int, $size: Int, $sort: String) {\n  pageablePersonMaintenanceRequests(\n    search: $search\n    page: $page\n    size: $size\n    sort: $sort\n  ) {\n    totalElements\n    totalPages\n    size\n    content {\n      ...MaintenanceRequestOverview\n      __typename\n    }\n    __typename\n  }\n}\n\nfragment MaintenanceRequestOverview on PersonMaintenanceRequest {\n  id\n  number\n  cleaningLocationGql {\n    description\n    originalCabinGql {\n      code\n      cabinCategoryValue {\n        translations\n        __typename\n      }\n      cabinType\n      __typename\n    }\n    originalLocationGql {\n      translations\n      locationTypesValue {\n        translations\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n  activeMaintenanceTeamGql {\n    description\n    __typename\n  }\n  displayCompletion\n  creationDTTMLocal\n  maintenanceRequestCodeGql {\n    description\n    operationalDepartmentGql {\n      description\n      __typename\n    }\n    issueGroupGql {\n      translations\n      __typename\n    }\n    issueCategoryGql {\n      translations\n      __typename\n    }\n    hasGuestImpact\n    __typename\n  }\n  assigneeReservation: assigneeGql {\n    ...MaintenanceRequestReservation\n    __typename\n  }\n  reportedByGql {\n    ...MaintenanceRequestReservation\n    __typename\n  }\n  priorityGql {\n    translations\n    __typename\n  }\n  statusGql {\n    ...LookupValueStore\n    __typename\n  }\n  statusDetailGql {\n    description\n    id\n    __typename\n  }\n  causeGql {\n    translations\n    __typename\n  }\n  createdBy\n  createdByGql {\n    ...UserProfileData\n    __typename\n  }\n  requestDetail\n  __typename\n}\n\nfragment MaintenanceRequestReservation on PersonReservation {\n  id\n  accountType\n  profile {\n    firstName\n    lastName\n    __typename\n  }\n  __typename\n}\n\nfragment LookupValueStore on LookupValue {\n  entityId\n  translations\n  code\n  externalDescription\n  enabled\n  deleted\n  __typename\n}\n\nfragment UserProfileData on User {\n  id\n  userProfile {\n    id\n    firstName\n    lastName\n    __typename\n  }\n  __typename\n}&quot;}</stringProp>
