    hierarchyId: $hierarchyId
    search: $search
    page: $page
    size: $size
    sort: $sort
    useCache: false
  ) {
    totalElements
    number
    totalPages
    content {
      ...LookupValueStore
      __typename
    }
    __typename
  }
}

