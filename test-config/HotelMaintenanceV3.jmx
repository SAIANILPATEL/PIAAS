            <stringProp name="GraphQLHTTPSampler.query">query LookupValuesStore($hierarchyId: String!, $search: String, $page: Int, $size: Int, $sort: String) {
  pageableLookupValues(
    hierarchyId: $hierarchyId
    search: $search
    page: $page
    size: $size
    sort: $sort
    useCache: false
  ) {
    totalElements
    number
    totalPages
    content {
      ...LookupValueStore
      __typename
    }
    __typename
  }
}

fragment LookupValueStore on LookupValue {
  entityId
  translations
  code
  externalDescription
  enabled
  deleted
  __typename
}
</stringProp>
