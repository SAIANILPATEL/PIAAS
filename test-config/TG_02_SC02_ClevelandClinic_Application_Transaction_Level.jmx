          <stringProp name="WebDriverSampler.script">// WDS.sampleResult.sampleStart()
//WDS.browser.get(&apos;http://jmeter-plugins.org&apos;)

WDS.browser.get(&quot;https://petstore.octoperf.com/&quot;);
    WDS.browser.findElement(org.openqa.selenium.By.linkText(&quot;Enter the Store&quot;)).click();
    WDS.browser.findElement(org.openqa.selenium.By.linkText(&quot;Sign In&quot;)).click();
    WDS.browser.findElement(org.openqa.selenium.By.id(&quot;stripes--881805403&quot;)).clear();
    WDS.browser.findElement(org.openqa.selenium.By.id(&quot;stripes--881805403&quot;)).sendKeys(&quot;j2ee&quot;);
    WDS.browser.findElement(org.openqa.selenium.By.name(&quot;j2ee&quot;)).click();
    WDS.browser.findElement(org.openqa.selenium.By.name(&quot;signon&quot;)).click();
    WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//div[@id=&apos;SidebarContent&apos;]/a/img&quot;)).click();
    WDS.browser.findElement(org.openqa.selenium.By.linkText(&quot;FI-SW-01&quot;)).click();
    WDS.browser.findElement(org.openqa.selenium.By.linkText(&quot;Add to Cart&quot;)).click();
    WDS.browser.findElement(org.openqa.selenium.By.linkText(&quot;Proceed to Checkout&quot;)).click();
    WDS.browser.findElement(org.openqa.selenium.By.name(&quot;newOrder&quot;)).click();
    WDS.browser.findElement(org.openqa.selenium.By.linkText(&quot;Confirm&quot;)).click();
    WDS.browser.findElement(org.openqa.selenium.By.linkText(&quot;Sign Out&quot;)).click();

// WDS.sampleResult.sampleEnd()
</stringProp>
