          <stringProp name="WebDriverSampler.script">import org.openqa.selenium.WebDriver
import org.openqa.selenium.By
import org.openqa.selenium.JavascriptExecutor
import org.openqa.selenium.support.ui.WebDriverWait
import org.openqa.selenium.support.ui.ExpectedConditions
import java.time.Duration

// WDS.sampleResult.sampleStart()
WebDriver driver=WDS.browser;

driver.get(&quot;https://my.clevelandclinic.org/&quot;);
driver.manage().window().maximize();
driver.findElement(By.xpath(&quot;//img[@alt=&apos;close button&apos;]&quot;)).click();
Thread.sleep(10000);
driver.findElement(By.xpath(&quot;//a[text()=&apos;Health Library&apos; and @class=&apos;nav--secondary__link &apos;]&quot;)).click();
Thread.sleep(10000);
try{
	driver.findElement(By.xpath(&quot;//img[@alt=&apos;close button&apos;]&quot;)).click();
	}
	catch(Exception e){
System.out.println(&quot;no updates to close&quot;);
		}
	
Thread.sleep(5000);
JavascriptExecutor js=(JavascriptExecutor)driver;
js.executeScript(&quot;arguments[0].scrollIntoView(true);&quot;,driver.findElement(By.xpath(&quot;//div[@class=&apos;az-letters__container&apos;]//a[contains(@id,&apos;-h&apos;)]&quot;)));

driver.findElement(By.xpath(&quot;//div[@class=&apos;az-letters__container&apos;]//a[contains(@id,&apos;-h&apos;)]&quot;)).click();
Thread.sleep(10000);
	WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(120));
    wait.until(ExpectedConditions.visibilityOfElementLocated(By.xpath(&quot;(//span[contains(@class,&apos;info-bar-count&apos;)])[2]&quot;)));
//waitForElement(By.xpath(&quot;(//span[contains(@class,&apos;info-bar-count&apos;)])[2]&quot;));
    wait.until(ExpectedConditions.visibilityOfElementLocated(By.xpath(&quot;(//div[@class=&apos;index-list__title&apos;])[2]&quot;)));
    Thread.sleep(5000);
//waitForElement(By.xpath(&quot;(//div[@class=&apos;index-list__title&apos;])[2]&quot;));
//js.executeScript(&quot;arguments[0].scrollIntoView(true);&quot;,driver.findElement(By.xpath(&quot;(//div[@class=&apos;index-list__title&apos;])[1]&quot;)));
Thread.sleep(30000);
driver.findElement(By.xpath(&quot;(//div[@class=&apos;index-list__title&apos;])[2]&quot;)).click();
    wait.until(ExpectedConditions.visibilityOfElementLocated(By.xpath(&quot;//h1[@data-identity=&apos;headline&apos;]&quot;)));
//waitForElement(By.xpath(&quot;//h1[@data-identity=&apos;headline&apos;]&quot;));
//
//public void waitForElement(By by){
//	WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(120));
//    wait.until(ExpectedConditions.visibilityOfElementLocated(by));
//	}
 
// WDS.sampleResult.sampleEnd()
</stringProp>
