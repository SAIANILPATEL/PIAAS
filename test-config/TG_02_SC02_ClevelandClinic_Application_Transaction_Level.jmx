        <hashTree/>
        <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui" testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler" testname="jp@gc - WebDriver Sampler if else" enabled="true">
          <stringProp name="WebDriverSampler.script">import org.openqa.selenium.WebDriver;
import org.openqa.selenium.By;
import org.openqa.selenium.JavascriptExecutor;
import org.openqa.selenium.support.ui.WebDriverWait;
import org.openqa.selenium.support.ui.ExpectedConditions;
import java.time.Duration;

WebDriver driver = WDS.browser;  // JMeter&apos;s WebDriver instance

// Start sample execution time tracking
WDS.sampleResult.sampleStart();

try {
    // Navigate to the website
    driver.get(&quot;https://my.clevelandclinic.org/&quot;);
    driver.manage().window().maximize();

    // Create WebDriverWait instance
    WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(20));

    // ✅ Wait for and close the initial pop-up if it exists
    By closeButton = By.xpath(&quot;//img[@alt=&apos;close button&apos;]&quot;);
    if (driver.findElements(closeButton).size() &gt; 0) {
        wait.until(ExpectedConditions.elementToBeClickable(closeButton)).click();
        System.out.println(&quot;Closed initial pop-up.&quot;);
    } else {
        System.out.println(&quot;No pop-up to close.&quot;);
    }

    // ✅ Wait for the &quot;Health Library&quot; link and click it
    By healthLibraryLink = By.xpath(&quot;//a[text()=&apos;Health Library&apos; and @class=&apos;nav--secondary__link &apos;]&quot;);
    wait.until(ExpectedConditions.elementToBeClickable(healthLibraryLink)).click();
    System.out.println(&quot;Navigated to Health Library.&quot;);

    // ✅ Handle another possible pop-up
    if (driver.findElements(closeButton).size() &gt; 0) {
        wait.until(ExpectedConditions.elementToBeClickable(closeButton)).click();
        System.out.println(&quot;Closed second pop-up.&quot;);
    } else {
        System.out.println(&quot;No second pop-up.&quot;);
    }

    // ✅ Scroll to the &quot;H&quot; section link
    JavascriptExecutor js = (JavascriptExecutor) driver;
    By hSection = By.xpath(&quot;//div[@class=&apos;az-letters__container&apos;]//a[contains(@id,&apos;-h&apos;)]&quot;);
    
    if (driver.findElements(hSection).size() &gt; 0) {
        js.executeScript(&quot;arguments[0].scrollIntoView(true);&quot;, driver.findElement(hSection));
        wait.until(ExpectedConditions.elementToBeClickable(hSection)).click();
        System.out.println(&quot;Navigated to &apos;H&apos; section.&quot;);
    } else {
        System.out.println(&quot;&apos;H&apos; section link not found.&quot;);
    }

    // ✅ Wait for content to load
    By infoBar = By.xpath(&quot;(//span[contains(@class,&apos;info-bar-count&apos;)])[2]&quot;);
    if (driver.findElements(infoBar).size() &gt; 0) {
        wait.until(ExpectedConditions.visibilityOfElementLocated(infoBar));
        System.out.println(&quot;Info bar is visible.&quot;);
    } else {
        System.out.println(&quot;Info bar not found.&quot;);
    }

    // ✅ Scroll and click on the index item
    By indexItem = By.xpath(&quot;(//div[@class=&apos;index-list__title&apos;])[2]&quot;);
    
    if (driver.findElements(indexItem).size() &gt; 0) {
        wait.until(ExpectedConditions.elementToBeClickable(indexItem)).click();
        System.out.println(&quot;Clicked on index item.&quot;);
    } else {
        System.out.println(&quot;Index item not found.&quot;);
    }

    // ✅ Wait until the headline is visible
    By headline = By.xpath(&quot;//h1[@data-identity=&apos;headline&apos;]&quot;);
    if (driver.findElements(headline).size() &gt; 0) {
        wait.until(ExpectedConditions.visibilityOfElementLocated(headline));
        System.out.println(&quot;Headline is visible.&quot;);
    } else {
        System.out.println(&quot;Headline not found.&quot;);
    }

} catch (Exception e) {
    System.out.println(&quot;Exception occurred: &quot; + e.getMessage());
} finally {
    // Stop the sample execution time tracking
    WDS.sampleResult.sampleEnd();
}
</stringProp>
