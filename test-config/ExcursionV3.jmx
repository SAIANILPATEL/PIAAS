h: \&quot;enabled==true and isDeleted==false\&quot;) {\n      id\n      ageGroup\n      enabled\n      deleted\n      departureTimeId\n      articlePriceEntityId\n      articlePriceObject(hierarchyId: $shipId) {\n        id\n        price\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n  tourActivityObject {\n    id\n    code\n    translations\n    packageLinks {\n      tourType\n      packageId\n      __typename\n    }\n    __typename\n  }\n  tourCategoryObject {\n    id\n    translations\n    __typename\n  }\n  tourDifficultyLevelObject {\n    id\n    translations\n    __typename\n  }\n  features {\n    featureObject {\n      id\n      icon\n      translations\n      __typename\n    }\n    __typename\n  }\n  languages {\n    languageId\n    languageObject {\n      id\n      code\n      __typename\n    }\n    allowedAutoBusCreation\n    defaultLanguage\n    maximumNoOfBuses\n    __typename\n  }\n  salesClassifications {\n    salesClassificationObject {\n      id\n      translations\n      __typename\n    }\n    __typename\n  }\n  showTour\n  bookTour\n  __typename\n}\n\nfragment bookableTour on BookableTour {\n  id\n  entityId\n  tourActivityEntityId\n  area\n  date\n  code\n  brochureId\n  overbook\n  waitlist\n  duration\n  minCapacity\n  maxCapacity\n  availableCapacity\n  translations\n  portObject {\n    id\n    translations\n    __typename\n  }\n  __typename\n}&quot;}</stringProp>
