            <stringProp name="GraphQLHTTPSampler.query">query PageableFilteredBookableTours($shipId: ID!, $search: String, $page: Int, $size: Int, $sort: String, $packaged: Boolean) {
  pageableFilteredBookableTours(
    shipId: $shipId
    search: $search
    page: $page
    size: $size
    sort: $sort
    packaged: $packaged
  ) {
    totalElements
    totalPages
    size
    numberOfElements
    content {
      ...BookableTourItem
      __typename
    }
    __typename
  }
