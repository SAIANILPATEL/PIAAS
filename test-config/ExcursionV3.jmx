ntNeededToAuthorization\n  authorizationAmount {\n    totalApproveAmount\n    authorizationDetails {\n      approveAmount\n      authorizationStatus\n      authorizationType\n      creditCardType\n      creditCardTypeName\n      paymentAuthorizationId\n      paymentMethodMerchantId\n      paymentMethodTokenId\n      pspReference\n      subdepartmentEntityId\n      __typename\n    }\n    subDepartmentEntityId\n    totalApproveAmount\n    __typename\n  }\n  birthNationality {\n    code\n    flagId\n    id\n    iso2\n    iso3\n    translations\n    __typename\n  }\n  birthday\n  boardCardId\n  bookingNumber\n  cabin {\n    code\n    deck {\n      code\n      id\n      translations\n      __typename\n    }\n    housekeepingSection\n    id\n    __typename\n  }\n  classifications {\n    code\n    id\n    entityId\n    translations\n    __typename\n  }\n  company\n  creditBalance {\n    creditLimitDaily\n    creditLimitTotal\n    leftToSpendToday\n    leftToSpendTotal\n    limitForAllDepartments\n    __typename\n  }\n  crewId\n  currentBalance {\n    creditBalance\n    currentBalance\n    debitBalance\n    nonRefundable\n    packageBalance\n    remainingBalance\n    zeroBalanceAccount\n    zeroBalanceAccountWithoutTransactions\n    __typename\n  }\n  daysPassed\n  daysRemaining\n  disallowedDepartments {\n    code\n    id\n    subDepartments {\n      code\n      id\n      translations\n      __typename\n    }\n    translations\n    __typename\n  }\n  displayDisembarkationVoyageDayId\n  enabled\n  externalBoardcardId\n  firstName\n  global\n  goldenId\n  groupExternalCode\n  groups {\n    code\n    description\n    disallowedDepartments {\n      code\n      id\n      subDepartments {\n        code\n        id\n        translations\n        __typename\n      }\n      translations\n      __typename\n    }\n    groupEnabled\n    groupSize\n    id\n    profileGroupId\n    reservationStatus\n    role {\n      code\n      entityId\n      hierarchyId\n      id\n      translations\