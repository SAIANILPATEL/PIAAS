            <stringProp name="GraphQLHTTPSampler.query">query Bookings($search: String, $page: Int, $size: Int, $sort: String, $shipId: ID) {
  bookings(search: $search, page: $page, size: $size, sort: $sort) {
    ...ExcursionBookingsListItem
    __typename
  }
}

fragment ExcursionBookingsListItem on Booking {
  ...bookingFragment
  discountReason
  participantObject {
    ...BookingManagementBookingListParticipant
    __typename
  }
  bookableTourId
  bookableTourObject(shipId: $shipId) {
    id
    code
    translations
    date
    promotionsEnabled
    documents {
      documentId
      required
      __typename
    }
    languages {
      ...BookingListBookableTourToLanguageLink
      __typename
    }
    __typename
  }
  bookableTourDepartureId
  bookableTourDepartureObject {
    id
    departureTime
    __typename
  }
  actions {
    dateTime
    tagType
    __typename
  }
  conflicts(shipId: $shipId) {
    code
    __typename
  }
  reservation {
    id
    ageGroups {
      group
      category
      __typename
    }
    age
    __typename
  }
  __typename
}

fragment bookingFragment on Booking {
  id
  ageGroup
  checkNo
  waitlistNo
  grossAmount
  quantity
  discount
  discountAmount
  netAmount
  prepaid
  languageCode
  bookingStatus
  comments
  longComments
  bookableTourId
  participantId
  transportationId
  bookableTourTicketTypeId
  __typename
}

fragment BookingManagementBookingListParticipant on PersonReservation {
  id
  cabin {
    code
    id
    __typename
  }
  profile {
    id
    firstName
    lastName
    __typename
  }
  personSearchGql {
    age
    currentBalance {
      remainingBalance
      __typename
    }
    ageGroups {
      group
      category
      __typename
    }
    __typename
  }
  __typename
}

fragment BookingListBookableTourToLanguageLink on BookableTourToLanguageLink {
  languageId
  languageObject {
    id
    code
    __typename
  }
  allowedAutoBusCreation
  defaultLanguage
  maximumNoOfBuses
  __typename
}
</stringProp>
