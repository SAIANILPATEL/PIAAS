            <stringProp name="GraphQLHTTPSampler.operationName">PageableBookingsOverviewForLanding</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">query PageableBookingsOverviewForLanding($shipId: ID!, $search: String, $page: Int, $size: Int, $sort: String) {
  pageableBookingsOverview(
    shipId: $shipId
    search: $search
    page: $page
    size: $size
    sort: $sort
  ) {
    totalElements
    totalPages
    size
    numberOfElements
    content {
      ...BookingOverviewForLanding
      __typename
    }
    __typename
  }
}

fragment BookingOverviewForLanding on BookingOverview {
  bookedAmount
  postedAmount
  waitlistAmount
  bookableTourId
  departures {
    bookableTourDepartureId
    bookableTourId
    bookedAmount
    postedAmount
    waitlistAmount
    __typename
  }
  bookableTourObject(shipId: $shipId) {
    id
    code
    date
    minCapacity
    maxCapacity
    tourActivityEntityId
    availableCapacity
    translations
    salesChannelsGql {
      id
      salesChannelTypeGql {
        code
        __typename
      }
      __typename
    }
    portId
    portObject {
      id
      translations
      officialDescription
      __typename
    }
    departuresObject(shipId: $shipId, search: &quot;isDeleted==false&quot;) {
      id
      meetingTime
      translations
      meetingLocationObject {
        id
        translations
        __typename
      }
      __typename
    }
    __typename
  }
  __typename
}
</stringProp>
