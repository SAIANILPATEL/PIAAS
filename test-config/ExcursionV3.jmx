                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;PageableBookingsOverviewForLanding&quot;,&quot;variables&quot;:{&quot;search&quot;:&quot;%28date%3E%3D${__time(YYYY-MM-dd,)}T00%3A00%3A00%20and%20date%3C%3D${__time(YYYY-MM-dd,)}T23%3A59%3A59%29%20and%20isDeleted%3D%3Dfalse%20and%20hierarchyId%3D%3D${ShipId}%20and%20hierarchyId%3D%3D${ShipId}&quot;,&quot;page&quot;:0,&quot;size&quot;:20,&quot;sort&quot;:&quot;date%2Cdesc&quot;,&quot;shipId&quot;:&quot;${ShipId}&quot;},&quot;query&quot;:&quot;query PageableBookingsOverviewForLanding($shipId: ID!, $search: String, $page: Int, $size: Int, $sort: String) {\n  pageableBookingsOverview(\n    shipId: $shipId\n    search: $search\n    page: $page\n    size: $size\n    sort: $sort\n  ) {\n    totalElements\n    totalPages\n    size\n    numberOfElements\n    content {\n      ...BookingOverviewForLanding\n      __typename\n    }\n    __typename\n  }\n}\n\nfragment BookingOverviewForLanding on BookingOverview {\n  bookedAmount\n  postedAmount\n  waitlistAmount\n  bookableTourId\n  departures {\n    bookableTourDepartureId\n    bookableTourId\n    bookedAmount\n    postedAmount\n    waitlistAmount\n    __typename\n  }\n  bookableTourObject(shipId: $shipId) {\n    id\n    code\n    date\n    minCapacity\n    maxCapacity\n    tourActivityEntityId\n    availableCapacity\n    translations\n    salesChannelsGql {\n      id\n      salesChannelTypeGql {\n        code\n        __typename\n      }\n      __typename\n    }\n    portId\n    portObject {\n      id\n      translations\n      officialDescription\n      __typename\n    }\n    departuresObject(shipId: $shipId, search: \&quot;isDeleted==false\&quot;) {\n      id\n      meetingTime\n      translations\n      meetingLocationObject {\n        id\n        translations\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n  __typename\n}&quot;}</stringProp>
