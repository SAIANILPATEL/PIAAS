}

fragment UserItem on User {
  rvcCategories
  inheritedRvcCategories
  groupIds
  allowManualSearch {
    inherited
    value
    __typename
  }
  creationDTTM
  firstName
  lastName
  id
  accountTypes
  inheritedAccountTypes
  userCredentials {
    email
    __typename
  }
  userExpiration {
    effectiveFrom
    effectiveTo
    effectiveFromOffset
    effectiveToOffset
    neverExpires
    __typename
  }
  userProfile {
    email
    firstName
    id
    lastName
    locale
    middleName
    phoneNumber
    __typename
  }
  person(search: $currentPersonSearch) {
    ...UserPerson
    __typename
  }
  userSecurity {
    forcePasswordChange
    invalidPinLocked
    pin
    pinInvalidAttempts
    pinInvalidCounterUntil
    pinInvalidCounterUntilOffset
    __typename
  }
  userTypeGql {
    shipUser
    __typename
  }
  when
  who
  __typename
}

fragment UserPerson on PersonSearch {
  reservationId
  profilePicId
  profilePicUrl
  firstName
  lastName
  reservation {
    accountType
    reservationStatus
    onboard
    operationalPositionId
    operationalPosition {
      description
      __typename
    }
    operationalDepartment {
      entityId
      description
      __typename
    }
    __typename
  }
  __typename
}
</stringProp>
