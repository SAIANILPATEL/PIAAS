fragment BookableTourItem on BookableTour {
  ...bookableTour
  packageLinks {
    tourId
    id
    __typename
  }
  salesChannelsGql {
    id
    tourActivityId
    salesChannelTypeObject {
      id
      code
      __typename
    }
    __typename
  }
  transportationAssignment
  autoAssignToTransport
  bookingOverviewGql {
    departures {
      bookableTourDepartureId
      bookedAmount
      waitlistAmount
      __typename
    }
    __typename
  }
  departuresObject(shipId: $shipId, search: &quot;isDeleted==false&quot;) {
    shipId
    id
    tourId
    tourType
    departureTime
    deleted
    transportationsGql(shipId: $shipId) {
      code
      availableCapacity
      bookingsGql {
        id
        deleted
        __typename
      }
      __typename
    }
    ticketTypeClassification {
      id
      deleted
      departureTimeId
      articlePriceEntityId
      articlePriceObject {
        id
        price
        __typename
      }
      ticketTypeClassification
      ticketTypeClassificationObject {
        id
        code
        translations
        __typename
      }
      __typename
    }
    ageGroups(search: &quot;enabled==true and isDeleted==false&quot;) {
      id
      ageGroup
      enabled
      deleted
      departureTimeId
      articlePriceEntityId
      articlePriceObject(hierarchyId: $shipId) {
        id
        price
        __typename
      }
      __typename
    }
    __typename
  }
  tourActivityObject {
    id
    code
    translations
    packageLinks {
      tourType
      packageId
      __typename
    }
    __typename
  }
  tourCategoryObject {
    id
    translations
    __typename
  }
  tourDifficultyLevelObject {
    id
    translations
    __typename
  }
  features {
    featureObject {
      id
      icon
      translations
      __typename
    }
    __typename
  }
  languages {
    languageId
    languageObject {
      id
      code
      __typename
    }
    allowedAutoBusCreation
    defaultLanguage
    maximumNoOfBuses
    __typename
  }
  salesClassifications {
    salesClassificationObject {
      id
      translations
      __typename
    }
    __typename
  }
  showTour
  bookTour
  __typename
}

fragment bookableTour on BookableTour {
  id
  entityId
  tourActivityEntityId
  area
  date
  code
  brochureId
  overbook
  waitlist
  duration
  minCapacity
  maxCapacity
  availableCapacity
  translations
  portObject {
    id
    translations
    __typename
  }
  __typename
}
