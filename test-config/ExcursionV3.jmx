__typename\n    }\n    ageGroups {\n      group\n      category\n      __typename\n    }\n    __typename\n  }\n  __typename\n}\n\nfragment BookingListBookableTourToLanguageLink on BookableTourToLanguageLink {\n  languageId\n  languageObject {\n    id\n    code\n    __typename\n  }\n  allowedAutoBusCreation\n  defaultLanguage\n  maximumNoOfBuses\n  __typename\n}&quot;}</stringProp>
