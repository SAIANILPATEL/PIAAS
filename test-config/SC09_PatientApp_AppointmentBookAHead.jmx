              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="script">// Define the file path
String filePath = &quot;output.txt&quot;;

// Retrieve JMeter variables
String var1 = vars.get(&quot;C_visitId&quot;) != null ? vars.get(&quot;C_visitId&quot;) : &quot;N/A&quot;;
String var2 = vars.get(&quot;P_bob&quot;) != null ? vars.get(&quot;P_bob&quot;) : &quot;N/A&quot;;
String var3 = vars.get(&quot;P_firstName&quot;) != null ? vars.get(&quot;P_firstName&quot;) : &quot;N/A&quot;;


// Format the line to append
String line = var1 + &quot;,&quot; + var2 + &quot;,&quot; + var3 + &quot;\n&quot;;

// Append to file using fully qualified class names
java.io.BufferedWriter writer = null;
try {
    writer = new java.io.BufferedWriter(new java.io.FileWriter(filePath, true)); // Append mode
    writer.write(line);
    writer.flush();
} catch (java.io.IOException e) {
    log.error(&quot;Error writing to file: &quot; + filePath, e);
} finally {
    if (writer != null) {
        try {
            writer.close();
        } catch (java.io.IOException e) {
            log.error(&quot;Error closing writer&quot;, e);
        }
    }
}
</stringProp>
