            <stringProp name="GraphQLHTTPSampler.operationName">getCentersByOrg</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">query getCentersByOrg($orgId: String!, $isVirtual: Boolean) {
  getCentersByOrg(orgId: $orgId, isVirtual: $isVirtual) {
    _id
    centerId
    driveThroughAvailable
    driveThroughClinicId
    isDriveThroughCenter
    facilityName
    slotCutOffTimeInMins
    configurableProperties {
      bookAheadSlotConfiguration {
        showTomorrowSlots
        todaySlotCutoffTime
        __typename
      }
      slotBuffer {
        isEnabled
        bufferTimeInMinutes
        __typename
      }
      flowForSlotBooking
      __typename
    }
    workSchedule {
      openingTime
      closingTime
      slotDuration
      workingDaysOfWeek
      __typename
    }
    __typename
  }
