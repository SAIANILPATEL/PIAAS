            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="script">import groovy.json.JsonOutput
def C_queue = vars.get(&quot;C_queue&quot;)
def C_slotStartTime = vars.get(&quot;C_slotStartTime&quot;)
def C_startTimeInMins = vars.get(&quot;C_startTimeInMins&quot;)
def C_date = vars.get(&quot;C_date&quot;)
def C_id = vars.get(&quot;C_id&quot;)
def C_getOrgByName = vars.get(&quot;C_getOrgByName&quot;)
def C_isDynamicallyAdded = vars.get(&quot;C_isDynamicallyAdded&quot;)
def P_UUID = vars.get(&quot;P_UUID&quot;)
def json = [
    slotQueueNumber       : vars.get(&quot;C_queue&quot;) as Integer,
    isOnlineSlot          : true,
    isNewBooking          : true,
    appointmentTime       : vars.get(&quot;C_slotStartTime&quot;),
    appointmentTimeInMins : vars.get(&quot;C_startTimeInMins&quot;) as Integer,
    appointmentDate       : vars.get(&quot;C_date&quot;),
    centerId              : vars.get(&quot;C_id&quot;),
    orgId                 : vars.get(&quot;C_getOrgByName&quot;),
    dfdSlotClientIp       : [
        clientIpFromBrowser: &quot;27.6.92.168&quot;,
        browserName        : new groovy.json.JsonBuilder([name: &quot;Firefox&quot;, version: &quot;137.0&quot;]).toString(),
        version            : new groovy.json.JsonBuilder([type: &quot;desktop&quot;, name: &quot;Windows&quot;, version: &quot;NT 10.0&quot;, versionName: &quot;10&quot;]).toString(),
        userAgent          : &quot;Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:137.0) Gecko/20100101 Firefox/137.0&quot;
    ],
    isDynamicallyAdded    : vars.get(&quot;C_isDynamicallyAdded&quot;) as Boolean,
    uuid                  : vars.get(&quot;P_UUID&quot;)
]
def finalJson = JsonOutput.toJson(json)
vars.put(&quot;encryptedText&quot;, finalJson)
//def encryptedText = &apos;&apos;&apos;{&quot;slotQueueNumber&quot;: ${C_queue},&quot;isOnlineSlot&quot;: true,&quot;isNewBooking&quot;: true,&quot;appointmentTime&quot;: &quot;${C_slotStartTime}&quot;,&quot;appointmentTimeInMins&quot;: ${C_startTimeInMins},&quot;appointmentDate&quot;: &quot;${C_date}&quot;,&quot;centerId&quot;: &quot;${C_id}&quot;,&quot;orgId&quot;: &quot;${C_getOrgByName}&quot;,&quot;dfdSlotClientIp&quot;: {&quot;clientIpFromBrowser&quot;: &quot;27.6.92.168&quot;,&quot;browserName&quot;: &quot;{\&quot;name\&quot;:\&quot;Firefox\&quot;,\&quot;version\&quot;:\&quot;137.0\&quot;}&quot;,&quot;version&quot;: &quot;{\&quot;type\&quot;:\&quot;desktop\&quot;,\&quot;name\&quot;:\&quot;Windows\&quot;,\&quot;version\&quot;:\&quot;NT 10.0\&quot;,\&quot;versionName\&quot;:\&quot;10\&quot;}&quot;,&quot;userAgent&quot;: &quot;Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:137.0) Gecko/20100101 Firefox/137.0&quot;},&quot;isDynamicallyAdded&quot;:${C_isDynamicallyAdded},&quot;uuid&quot;: &quot;${P_UUID}&quot;}&apos;&apos;&apos;

vars.put(&quot;Text&quot;,finalJson)

log.info(&quot;---------------&quot;+finalJson)</stringProp>
            </JSR223PostProcessor>
