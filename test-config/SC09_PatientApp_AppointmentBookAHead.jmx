            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="script">// Path to your Node.js script
def scriptPath = &apos;/home/ubuntu/encrypt_script.js&apos;

// Action and input text
def action = &apos;encrypt&apos;
def encryptedText = vars.get(&quot;Text&quot;)

if (encryptedText == null || encryptedText.trim().isEmpty()) {
    log.error(&quot;Input text is missing or empty.&quot;)
    throw new IllegalArgumentException(&quot;Missing input text for encryption/decryption.&quot;)
}

// Construct command
def command = [&quot;node&quot;, scriptPath, action, encryptedText, &quot;EncryptDecyptForDigitalFrontDoor&quot;]

try {
    def process = new ProcessBuilder(command)
        .redirectErrorStream(true)
        .start()

    // Optional timeout (in milliseconds)
//    def timeoutMillis = 5000
//    if (!process.waitFor(timeoutMillis, java.util.concurrent.TimeUnit.MILLISECONDS)) {
//        process.destroy()
//        throw new RuntimeException(&quot;Node.js script timed out after ${timeoutMillis}ms.&quot;)
//    }

    // Read output
    def output = process.in.text.trim()

    if (output == null || output.isEmpty()) {
        throw new RuntimeException(&quot;Node.js script returned empty output.&quot;)
    }

    log.info(&quot;Output from Node.js script: &quot; + output)

    // Store in JMeter variable
    vars.put(&quot;decryptedText&quot;, output)

} catch (Exception e) {
    log.error(&quot;Error executing Node.js script: &quot; + e.getMessage(), e)
    // Optionally set a fallback value or fail the sampler
    vars.put(&quot;decryptedText&quot;, &quot;ERROR&quot;)
    // Optionally fail the test if critical
    // SampleResult.setSuccessful(false)
}
</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="false">
              <stringProp name="scriptLanguage">beanshell</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="script">import javax.crypto.Cipher;
import javax.crypto.spec.IvParameterSpec;
import javax.crypto.spec.SecretKeySpec;
import java.security.SecureRandom;
import java.util.Base64;
 
// --- CONFIGURE ---
String encryptionKey = &quot;EncryptDecyptForDigitalFrontDoor&quot;; // 32 bytes = AES-256
String charsetName = &quot;UTF-8&quot;;
String action = &quot;encrypt&quot;; // Change to &quot;decrypt&quot; to decrypt
String inputText = vars.get(&quot;Text&quot;); // The text to encrypt/decrypt
 
// --- PREPARE KEY ---
byte[] keyBytes = encryptionKey.getBytes(charsetName);
SecretKeySpec secretKey = new SecretKeySpec(keyBytes, &quot;AES&quot;);
 
//if (&quot;encrypt&quot;.equalsIgnoreCase(action)) {
    // --- Generate IV ---
    byte[] ivBytes = new byte[16];
    SecureRandom random = new SecureRandom();
    random.nextBytes(ivBytes);
    IvParameterSpec ivSpec = new IvParameterSpec(ivBytes);
 
    // --- Encrypt ---
    Cipher cipher = Cipher.getInstance(&quot;AES/CBC/PKCS5Padding&quot;);
    cipher.init(Cipher.ENCRYPT_MODE, secretKey, ivSpec);
    byte[] encryptedBytes = cipher.doFinal(inputText.getBytes(charsetName));
 
    // --- Encode IV + ciphertext ---
    String ivBase64 = Base64.getEncoder().encodeToString(ivBytes);
    String ciphertextBase64 = Base64.getEncoder().encodeToString(encryptedBytes);
    String result = ivBase64 + &quot;|&quot; + ciphertextBase64;
 
    log.info(&quot;Encrypted: &quot; + result);
    vars.put(&quot;decryptedText&quot;, result);  // save to JMeter variable
 
//} else if (&quot;decrypt&quot;.equalsIgnoreCase(action)) {
    // Assuming inputText is in IV|ciphertext format
    String[] parts = vars.get(&quot;decryptedText&quot;);
    if (parts.length != 2) {
        throw new Exception(&quot;Invalid encrypted data format&quot;);
    }
    byte[] ivBytes = Base64.getDecoder().decode(parts[0]);
    byte[] ciphertextBytes = Base64.getDecoder().decode(parts[1]);
    IvParameterSpec ivSpec = new IvParameterSpec(ivBytes);
 
    // --- Decrypt ---
    Cipher cipher = Cipher.getInstance(&quot;AES/CBC/PKCS5Padding&quot;);
    cipher.init(Cipher.DECRYPT_MODE, secretKey, ivSpec);
    byte[] decryptedBytes = cipher.doFinal(ciphertextBytes);
    String decrypted = new String(decryptedBytes, charsetName);
 
    log.info(&quot;Decrypted: &quot; + decrypted);
    vars.put(&quot;decryptedData&quot;, decrypted);  // save to JMeter variable
//} else {
//    throw new Exception(&quot;Invalid action specified. Use &apos;encrypt&apos; or &apos;decrypt&apos;.&quot;);
//}</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="false">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import javax.crypto.Cipher
import javax.crypto.spec.IvParameterSpec
import javax.crypto.spec.SecretKeySpec
import java.security.MessageDigest
import java.security.SecureRandom
import java.util.Base64

def encryptionKey = &quot;EncryptDecyptForDigitalFrontDoor&quot;
def charset = &quot;UTF-8&quot;

def getKeyBytes = { key -&gt;
    MessageDigest sha = MessageDigest.getInstance(&quot;SHA-256&quot;)
    return sha.digest(key.getBytes(charset))
}

def encrypt = { plaintext -&gt;
    byte[] iv = new byte[16]
    new SecureRandom().nextBytes(iv)
    IvParameterSpec ivSpec = new IvParameterSpec(iv)

    SecretKeySpec keySpec = new SecretKeySpec(getKeyBytes(encryptionKey), &quot;AES&quot;)
    Cipher cipher = Cipher.getInstance(&quot;AES/CBC/PKCS5Padding&quot;)
    cipher.init(Cipher.ENCRYPT_MODE, keySpec, ivSpec)
    byte[] encrypted = cipher.doFinal(plaintext.getBytes(charset))

    def ivBase64 = Base64.encoder.encodeToString(iv)
    def encryptedBase64 = Base64.encoder.encodeToString(encrypted)
    return ivBase64 + &quot;|&quot; + encryptedBase64
}

def decrypt = { encryptedData -&gt;
    def parts = encryptedData.split(&quot;\\|&quot;)
    if (parts.length != 2) throw new IllegalArgumentException(&quot;Invalid format&quot;)

    def iv = Base64.decoder.decode(parts[0])
    def encryptedBytes = Base64.decoder.decode(parts[1])

    IvParameterSpec ivSpec = new IvParameterSpec(iv)
    SecretKeySpec keySpec = new SecretKeySpec(getKeyBytes(encryptionKey), &quot;AES&quot;)
    Cipher cipher = Cipher.getInstance(&quot;AES/CBC/PKCS5Padding&quot;)
    cipher.init(Cipher.DECRYPT_MODE, keySpec, ivSpec)

    byte[] decrypted = cipher.doFinal(encryptedBytes)
    return new String(decrypted, charset)
}

// Example usage
def action = &quot;encrypt&quot;  // use JMeter variable e.g. encrypt or decrypt
def inputData =  vars.get(&quot;Text&quot;)

def result = (action == &quot;encrypt&quot;) ? encrypt(inputData) : decrypt(inputData)
log.info(&quot;---------------&quot;+result)
vars.put(&quot;decryptedText&quot;, result) // Store result in a JMeter variable
result =decrypt(inputData)
log.info(&quot;---------------&quot;+result)
</stringProp>
            </JSR223PostProcessor>
