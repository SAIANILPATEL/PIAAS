            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="false">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import javax.crypto.Cipher
import javax.crypto.spec.IvParameterSpec
import javax.crypto.spec.SecretKeySpec
import java.util.Base64

// Simulate applicationConfig.digitalFrontDoorEncyptionKey
String encryptionKey = &quot;EncryptDecyptForDigitalFrontDoor&quot;  // 32 characters

// Encrypted input in format: base64_iv|base64_ciphertext
String encryptedInput = &quot;o8vRgBE7/WmgDlauxBSPzQ==|&quot;  // Or hardcode for testing

try {
    def parts = encryptedInput.split(&quot;\\|&quot;)
    if (parts.length != 2) {
        throw new IllegalArgumentException(&quot;Encrypted data format invalid&quot;)
    }

    byte[] ivBytes = Base64.decoder.decode(parts[0])
    byte[] encryptedBytes = Base64.decoder.decode(parts[1])

    IvParameterSpec ivSpec = new IvParameterSpec(ivBytes)
    SecretKeySpec secretKey = new SecretKeySpec(encryptionKey.getBytes(&quot;UTF-8&quot;), &quot;AES&quot;)

    Cipher cipher = Cipher.getInstance(&quot;AES/CBC/PKCS5Padding&quot;)
    cipher.init(Cipher.DECRYPT_MODE, secretKey, ivSpec)

    byte[] decryptedBytes = cipher.doFinal(encryptedBytes)
    String decryptedText = new String(decryptedBytes, &quot;UTF-8&quot;)

    // Print or store the result
    log.info(&quot;Decrypted text: &quot; + decryptedText)
    vars.put(&quot;DECRYPTED_RESULT&quot;, decryptedText)
} catch (Exception ex) {
    log.error(&quot;Decryption failed&quot;, ex)
    vars.put(&quot;DECRYPTED_RESULT&quot;, &quot;ERROR&quot;)
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
