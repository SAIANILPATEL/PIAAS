  reservationId
  profilePicId
  profilePicUrl
  firstName
  lastName
  reservation {
    accountType
    reservationStatus
    onboard
    operationalPositionId
    operationalPosition {
      description
      __typename
    }
    operationalDepartment {
      entityId
      description
      __typename
    }
    __typename
  }
  __typename
}
