  userExpiration {
    effectiveFrom
    effectiveTo
    effectiveFromOffset
    effectiveToOffset
    neverExpires
    __typename
  }
  userProfile {
    email
    firstName
    id
    lastName
    locale
    middleName
    phoneNumber
    __typename
  }
  person(search: $currentPersonSearch) {
    ...UserPerson
    __typename
  }
  userSecurity {
    forcePasswordChange
    invalidPinLocked
    pin
    pinInvalidAttempts
    pinInvalidCounterUntil
    pinInvalidCounterUntilOffset
    __typename
  }
  userTypeGql {
    shipUser
    __typename
  }
  when
  who
  __typename
}

