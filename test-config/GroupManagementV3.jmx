    groupReservationId: $groupReservationId
    search: $search
    page: $page
    size: $size
    sort: $sort
  ) {
    totalElements
    content {
      ...GroupMembersListItem
      __typename
    }
    __typename
  }
}

fragment GroupMembersListItem on GroupMember {
  personReservationId
  personReservationGql {
    ...GroupMembersReservation
    __typename
  }
  groupRoleGql {
    entityId
    code
    translations
    __typename
  }
  __typename
}

fragment GroupMembersReservation on AllReservationSearch {
  id
  firstName
  lastName
  reservationStatus
  cabin {
    code
    __typename
  }
  pictureId
  onboard
  bookingNumber
  travelWith
  activeFrom
  activeTo
  __typename
}
</stringProp>
