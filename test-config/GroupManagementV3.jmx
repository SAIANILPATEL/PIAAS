            <stringProp name="GraphQLHTTPSampler.query">query AllGroupReservations($search: String, $page: Int, $size: Int, $sort: String) {
  pageableModel: pageableAllReservationSearches(
    search: $search
    page: $page
    size: $size
    sort: $sort
  ) {
    totalElements
    content {
      id
      profileDescription
      reservationStatus
      profileCode
      groupExternalCode
      activeFrom
      activeTo
      allMemberCount
      pictureId
      onboard
      mainContactPerson {
        lastName
        firstName
        __typename
      }
      currentBalance {
        currentBalance
        __typename
      }
      __typename
    }
    __typename
  }
}
</stringProp>
