            <stringProp name="GraphQLHTTPSampler.query">query GuestSearchList($search: String, $page: Int, $size: Int, $sort: String, $hierarchyId: String, $withServiceItemRequestsInfo: Boolean = false, $withPersonSearchInfo: Boolean = false, $withLoyaltyProgramValueInfo: Boolean = false) {
  pageableAllReservationSearches(
    search: $search
    page: $page
    size: $size
    sort: $sort
  ) {
    totalElements
    number
    totalPages
    content {
      ...GuestSearch
      __typename
    }
    __typename
  }
}

fragment GuestSearch on AllReservationSearch {
  absenceDetails {
    absenceEndDate
    absenceReason
    absenceStartDate
    absenceTourDescription
    absenceTourId
    currentlyAbsent
    __typename
  }
  accountType
  activeFrom
  activeFromTime
  activeTo
  activeToTime
  activityDetails {
    participateInActivities
    __typename
  }
  actualDisembarkationVoyageDayId
  actualEmbarkationVoyageDayId
  age
  ageGroups {
    category
    group
    __typename
  }
  allMemberCount
  amountNeededToAuthorization
  authorizationAmount {
    totalApproveAmount
    authorizationDetails {
      approveAmount
      authorizationStatus
      authorizationType
      creditCardType
      creditCardTypeName
      paymentAuthorizationId
      paymentMethodMerchantId
      paymentMethodTokenId
      pspReference
      subdepartmentEntityId
      __typename
    }
    subDepartmentEntityId
    totalApproveAmount
