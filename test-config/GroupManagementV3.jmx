            <stringProp name="GraphQLHTTPSampler.query">query PageableGroupMembers($groupReservationId: ID!, $search: String, $page: Int, $size: Int, $sort: String) {
  pageableGroupMembers(
    groupReservationId: $groupReservationId
    search: $search
    page: $page
    size: $size
    sort: $sort
  ) {
    totalElements
    content {
      ...GroupMembersItem
      __typename
    }
    __typename
  }
}

fragment GroupMembersItem on GroupMember {
  groupRoleGql {
    entityId
    code
    translations
    __typename
  }
  __typename
}
</stringProp>
