            <stringProp name="GraphQLHTTPSampler.query">query PageableGroupMembersList($groupReservationId: ID!, $search: String, $page: Int, $size: Int, $sort: String) {
  pageableGroupMembers(
    groupReservationId: $groupReservationId
    search: $search
    page: $page
    size: $size
