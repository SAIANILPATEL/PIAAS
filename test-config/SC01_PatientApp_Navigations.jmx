    computedSlots {
      slotForToday {
        startTimeInMins
        date
        endTimeInMins
        slotDuringHourList {
          label
          slotStartTime
          slotEndTime
          queue
          isDynamicallyAdded
          __typename
        }
        __typename
      }
      slotForTomorrow {
        startTimeInMins
        date
        endTimeInMins
        slotDuringHourList {
          label
          slotStartTime
          slotEndTime
          queue
          isDynamicallyAdded
          __typename
        }
        __typename
      }
      __typename
    }
    __typename
  }
}</stringProp>
