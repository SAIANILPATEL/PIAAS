                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;getVisitByIdAndDob&quot;,&quot;variables&quot;:{&quot;dob&quot;:&quot;${C_dob}&quot;,&quot;visitId&quot;:&quot;${decryptedvisitId}&quot;},&quot;query&quot;:&quot;query getVisitByIdAndDob($visitId: String!, $dob: DateTime!) {\n  getVisitByIdAndDob(visitId: $visitId, dob: $dob) {\n    _id\n    checkinLocation\n    channel\n    visitCreatedIn\n    occMedNewCompany\n    rcmPayment {\n      patientResponsibility {\n        isAmountToBeCollected\n        isTypeCopay\n        isTypeCoInsurance\n        isTypeDeductible\n        isTypeSelfPay\n        paymentType {\n          coPay {\n            isAmountToBeCollected\n            amount\n            collected\n            isCollected\n            __typename\n          }\n          deductible {\n            isAmountToBeCollected\n            amount\n            collected\n            isCollected\n            __typename\n          }\n          selfPay {\n            isAmountToBeCollected\n            amount\n            collected\n            isCollected\n            __typename\n          }\n          __typename\n        }\n        amount\n        comments\n        isTotalAmountCollected\n        collectedAmount\n        commentsAtCollection\n        isResponsibilityPaidPartially\n        reasonForNotPaying\n        otherReasonCommentForPatientResponsibility\n        __typename\n      }\n      patientOutstanding {\n        isOutstandingBalance\n        amount\n        comments\n        isTotalOutstandingCollected\n        collectedAmount\n        commentsAtCollection\n        isOutstandingPaidPartially\n        reasonForNotPaying\n        otherReasonCommentForOutstanding\n        __typename\n      }\n      timeStamp\n      billedBy\n      collectedBy\n      __typename\n    }\n    mrn\n    centerInfo {\n      centerId\n      facilityName\n      providerName\n      orgName\n      address {\n        address1\n        city\n        state\n        zipcode\n        coordinates\n        __typename\n      }\n      __typename\n    }\n    email\n    phoneNumber\n    consentToBookAhead\n    virtualLocationConfirmation\n    createdDateTime\n    updatedDateTime\n    appointment {\n      date\n      startTimeInMins\n      endTimeInMins\n      slotQueue\n      slotStartTime\n      slotEndTime\n      __typename\n    }\n    reason\n    currentStatusCode\n    currentSubStatusCode\n    consentToSMSNotification\n    isNewVisit\n    isFollowUpVisit\n    isFollowUpCreated\n    followup {\n      visitTimeStamp\n      visitClinic\n      visitCreatedBy\n      visitCode\n      __typename\n    }\n    attendedBy\n    patientInfo {\n      patientId\n      firstName\n      lastName\n      middleName\n      preferredName\n      dateOfBirth\n      sex\n      language\n      isMarried\n      ethnicity\n      race\n      ssn\n      preferredPharmacy {\n        name\n        address\n        __typename\n      }\n      __typename\n    }\n    photoIdUri {\n      front {\n        name\n        uri\n        previewBase64\n        __typename\n      }\n      back {\n        name\n        uri\n        previewBase64\n        __typename\n      }\n      __typename\n    }\n    contactDetails {\n      phoneNumber\n      email\n      address1\n      address2\n      city\n      state\n      zipCode\n      __typename\n    }\n    primaryCare {\n      care\n      physician\n      phone\n      __typename\n    }\n    emergencyContact {\n      name\n      phone\n      relationship\n      otherRelationship\n      __typename\n    }\n    responsibleParty {\n      relationshipToSubscriber\n      firstName\n      lastName\n      dateOfBirth\n      email\n      phone\n      __typename\n    }\n    priority\n    isAdhocVisit\n    isNurseVisit\n    isTelemedVisit\n    visitAudit {\n      timeStamp\n      actionTakenBy\n      field\n      fieldAudit {\n        fieldName\n        oldValue\n        newValue\n        __typename\n      }\n      __typename\n    }\n    previousPriority\n    secondaryInsuranceInfo {\n      isSecondaryAvailable\n      otherInsuranceCompany\n      ssn\n      insuranceCompany\n      insuranceCoverageType\n      memberId\n      groupNumber\n      insuranceIdUri {\n        front {\n          name\n          uri\n          previewBase64\n          __typename\n        }\n        back {\n          name\n          uri\n          previewBase64\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    insuranceInfo {\n      ssn\n      insuranceCompany\n      otherInsuranceCompany\n      insuranceCoverageType\n      memberId\n      groupNumber\n      insuranceIdUri {\n        front {\n          name\n          uri\n          previewBase64\n          __typename\n        }\n        back {\n          name\n          uri\n          previewBase64\n          __typename\n        }\n        __typename\n      }\n      secondaryInsurance\n      vaNotified\n      isInsurancePlanIsNotAccepted\n      insurancePlan\n      __typename\n    }\n    idMismatchInfo\n    insuranceMismatchInfo\n    childProxyConsent {\n      firstName\n      consentToChart\n      signature\n      __typename\n    }\n    registrationChecks {\n      identity\n      forms\n      insurance\n      medicare\n      patientDetails\n      contactDetails\n      insuranceDetails\n      medicare\n      insuranceHolder\n      financialResponsibility\n      condOfServAndConsentToTreat\n      patientFinancialResponsibility\n      authToReleaseInfo\n      ackOfRightsAndPrivacy\n      medicalRecordDiscloser\n      childProxyForm\n      childProxyConsent\n      occMedRegistrationStatus\n      occMedPatientDetails\n      occMedCompanyInformation\n      workRelatedInjuryForm\n      patientConsentForm\n      __typename\n    }\n    occMed {\n      rescheduleLocationIfRequired\n      haveWorkInjury\n      driversLicenseClass\n      patientID\n      license\n      stateIssue\n      driversLicenseClass\n      driversLicenseIdUri {\n        fr