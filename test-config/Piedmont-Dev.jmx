            <stringProp name="GraphQLHTTPSampler.query">query getOpeningClosingInfo($orgId: String!) {
  getOpeningClosingInfo(orgId: $orgId) {
    earliestOpeningTimeForWeekdays
    latestClosingTimeForWeekdays
    earliestOpeningTimeForSaturday
