            <stringProp name="GraphQLHTTPSampler.query">query getOrgByName($name: String!) {
  getOrgByName(name: $name) {
    _id
    name
    isActive
    isVirtualVisitButton
    displayName
    regionId
    regionName
    timezone
    orgAccronym
    configurableProperties {
      isAllSlotsFilterOptionEnabled
      flowForSlotBooking
      epicBaseUrl
      isEpicFlowOpenNewTab
      selRfvId
      selRfvIdForVirtual
      enableGoogleAnalytics
      patientAccess {
        isEnabled
        contextObject
        __typename
      }
      __typename
    }
    __typename
  }
}</stringProp>
