            <stringProp name="GraphQLHTTPSampler.operationName">getRegistrationTemplate</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">query getRegistrationTemplate($formTemplateName: String!, $lang: String!, $centerId: String!) {
  formTemplate(
    formTemplateName: $formTemplateName
    lang: $lang
    centerId: $centerId
  ) {
    _id
    formTemplateName
    version
    pages {
      pageId
      pageName
      stepName
      formIncompleteStatusMsg
      hasNoMandatoryFields
      updateFlag {
        apiModelRef
        __typename
      }
      showIf {
        pageIndex
        questionIndex
        fieldIndex
        choice
        sectionIndex
        condition
        fieldType
        value
        __typename
      }
      section {
        showIf {
          pageIndex
          questionIndex
          fieldIndex
          choice
          sectionIndex
          __typename
        }
        footer {
          isBackground
          message
          showIf {
            pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            __typename
          }
          __typename
        }
        header {
          isBackground
          message
          showIf {
            pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            __typename
          }
          __typename
        }
        questions {
          label
          labelHeader
          labelHtml
          hint
          help
          indicate
          helpLabel
          modalHeadLabel
          isIconHelpOnly
          isGroupField
          isTableViewRadioButtons
          isGroupedHyperLink
          showIf {
            pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            condition
            fieldType
            value
            __typename
          }
          showIfAny {
            pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            __typename
          }
          fieldGroups {
            isAcceptableFormID
            modalHeadLabel
            isBottomBoder
            field {
              _id
              fieldId
              label
              multiLingualChoices {
                label
                value
                __typename
              }
              value
              placeholder
              isBackground
              isCenterAlign
              isGroupedLabels
              isBackground
              readonly
              isGroupField
              answerType {
                _id
                answerType
                choicesAvailable
                __typename
              }
              __typename
            }
            display {
              flex
              responsiveFlex
              __typename
            }
            value
            apiModelRef
            apiModelRefSecondary
            validation {
              required
              errorMessage
              minLength
              maxLength
              __typename
            }
            showIf {
              pageId: pageIndex
              questionIndex
              fieldIndex
              choice
              sectionIndex
              condition
              fieldType
              value
              __typename
            }
            showIfAny {
              pageId: pageIndex
              questionIndex
              fieldIndex
              choice
              sectionIndex
              __typename
            }
            showIfAll {
              pageId: pageIndex
              questionIndex
              fieldIndex
              choice
              sectionIndex
              condition
              fieldType
              value
              __typename
            }
            __typename
          }
          __typename
        }
        __typename
      }
