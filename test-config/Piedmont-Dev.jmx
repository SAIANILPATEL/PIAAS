        showIf {
          pageId: pageIndex
          questionIndex
          fieldIndex
          choice
          sectionIndex
          __typename
        }
        footer {
          isBackground
          message
          showIf {
            pageId: pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            __typename
          }
          __typename
        }
        header {
          isBackground
          message
          showIf {
            pageId: pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            __typename
          }
          __typename
        }
        questions {
