          labelHtml
          hint
          help
          indicate
          helpLabel
          modalHeadLabel
          isIconHelpOnly
          isGroupField
          isTableViewRadioButtons
          isGroupedHyperLink
          multiLingualChoices {
            label
            value
            __typename
          }
          showIf {
            pageId: pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            condition
            fieldType
            value
            __typename
          }
          showIfAny {
            pageId: pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            __typename
          }
          showIfAll {
            pageId: pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            condition
            fieldType
            value
            __typename
          }
          fieldGroups {
            isAcceptableFormID
            modalHeadLabel
            isBottomBoder
            showIf {
              pageId: pageIndex
              questionIndex
              fieldIndex
              choice
              choices
              sectionIndex
              condition
              fieldType
              value
              __typename
            }
            showIfAny {
              pageId: pageIndex
