            <stringProp name="GraphQLHTTPSampler.operationName">getVisitByIdAndDob</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">query getVisitByIdAndDob($visitId: String!, $dob: DateTime!) {
  getVisitByIdAndDob(visitId: $visitId, dob: $dob) {
    _id
    checkinLocation
    channel
    visitCreatedIn
    occMedNewCompany
    rcmPayment {
      patientResponsibility {
        isAmountToBeCollected
        isTypeCopay
        isTypeCoInsurance
        isTypeDeductible
        isTypeSelfPay
        paymentType {
          coPay {
            isAmountToBeCollected
            amount
            collected
            isCollected
            __typename
          }
          deductible {
            isAmountToBeCollected
            amount
            collected
            isCollected
            __typename
          }
          selfPay {
            isAmountToBeCollected
            amount
            collected
            isCollected
            __typename
          }
          __typename
        }
        amount
        comments
        isTotalAmountCollected
        collectedAmount
        commentsAtCollection
        isResponsibilityPaidPartially
        reasonForNotPaying
        otherReasonCommentForPatientResponsibility
        __typename
      }
      patientOutstanding {
        isOutstandingBalance
        amount
        comments
        isTotalOutstandingCollected
        collectedAmount
        commentsAtCollection
        isOutstandingPaidPartially
        reasonForNotPaying
        otherReasonCommentForOutstanding
        __typename
      }
      timeStamp
      billedBy
      collectedBy
      __typename
    }
    mrn
    centerInfo {
      centerId
      facilityName
      providerName
      orgName
      address {
        address1
        city
        state
        zipcode
        coordinates
        __typename
      }
      __typename
    }
    email
    phoneNumber
    consentToBookAhead
    virtualLocationConfirmation
    createdDateTime
    updatedDateTime
    appointment {
      date
      startTimeInMins
      endTimeInMins
      slotQueue
      slotStartTime
      slotEndTime
      __typename
    }
    reason
    currentStatusCode
    currentSubStatusCode
    consentToSMSNotification
    isNewVisit
    isFollowUpVisit
    isFollowUpCreated
    followup {
      visitTimeStamp
      visitClinic
      visitCreatedBy
      visitCode
      __typename
    }
    attendedBy
    patientInfo {
      patientId
      firstName
      lastName
      middleName
      preferredName
      dateOfBirth
      sex
      language
      isMarried
      ethnicity
      race
      ssn
      preferredPharmacy {
        name
        address
        __typename
      }
      __typename
    }
    photoIdUri {
      front {
        name
        uri
        previewBase64
        __typename
      }
      back {
        name
        uri
        previewBase64
        __typename
      }
      __typename
    }
    contactDetails {
      phoneNumber
      email
      address1
      address2
      city
      state
      zipCode
