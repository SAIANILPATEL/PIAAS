        fieldIndex
        choice
        sectionIndex
        condition
        fieldType
        value
        __typename
      }
      showIfAll {
        pageIndex
        questionIndex
        fieldIndex
        choice
        sectionIndex
        condition
        fieldType
        value
        __typename
      }
      __typename
    }
    __typename
  }
}</stringProp>
