   inExamAttendedBy {\n      _id\n      attendedBy\n      userJoined\n      isUserEverJoined\n      isVideoLinkShared\n      isClaimed\n      providerJoined\n      notes {\n        comments\n        timeStamp\n        notesBy\n        hasNew\n        email\n        __typename\n      }\n      __typename\n    }\n    previousNotes {\n      visitComments\n      visitTimeStamp\n      visitNotesBy\n      visitTelemedComments\n      visitTelemedNotesBy\n      visitTelemadTimeStamp\n      visitTelemedAttendedBy\n      visitCreatedBy\n      visitCode\n      isFollowUpTelemedVisit\n      isFollowUpTelemedVisitCovidOnly\n      isInClinicProviderVisitRequired\n      centerInfo {\n        centerId\n        facilityName\n        providerName\n        address {\n          address1\n          city\n          state\n          zipcode\n          coordinates\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    reasonForCancellation\n    reasonForCancellationComment\n    isFollowUpPhysicalVisit\n    isInClinicProviderVisitRequired\n    isFollowUpTelemedVisitCovidOnly\n    isFollowUpTelemedVisit\n    __typename\n  }\n}&quot;}</stringProp>
