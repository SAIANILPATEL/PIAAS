                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;getRegistrationTemplate&quot;,&quot;variables&quot;:{&quot;formTemplateName&quot;:&quot;piedmont Registration Template&quot;,&quot;lang&quot;:&quot;en&quot;,&quot;centerId&quot;:&quot;${C_centerId}&quot;},&quot;query&quot;:&quot;query getRegistrationTemplate($formTemplateName: String!, $lang: String!, $centerId: String!) {\n  formTemplate(\n    formTemplateName: $formTemplateName\n    lang: $lang\n    centerId: $centerId\n  ) {\n    _id\n    formTemplateName\n    version\n    pages {\n      pageId\n      pageName\n      stepName\n      formIncompleteStatusMsg\n      groupIndex\n      groupName\n      hasNoMandatoryFields\n      updateFlag {\n        apiModelRef\n        __typename\n      }\n      showIf {\n        pageId: pageIndex\n        questionIndex\n        fieldIndex\n        choice\n        sectionIndex\n        condition\n        fieldType\n        value\n        __typename\n      }\n      section {\n        showInfo {\n          apiModelRef\n          type\n          __typename\n        }\n        showIf {\n          pageId: pageIndex\n          questionIndex\n          fieldIndex\n          choice\n          sectionIndex\n          __typename\n        }\n        footer {\n          isBackground\n          message\n          showIf {\n            pageId: pageIndex\n            questionIndex\n            fieldIndex\n            choice\n            sectionIndex\n            __typename\n          }\n          __typename\n        }\n        header {\n          isBackground\n          message\n          showIf {\n            pageId: pageIndex\n            questionIndex\n            fieldIndex\n            choice\n            sectionIndex\n            __typename\n          }\n          __typename\n        }\n        questions {\n          label\n          labelHeader\n          labelHtml\n          hint\n          help\n          indicate\n          helpLabel\n          modalHeadLabel\n          isIconHelpOnly\n          isGroupField\n          isTableViewRadioButtons\n          isGroupedHyperLink\n          multiLingualChoices {\n            label\n            value\n            __typename\n          }\n          showIf {\n            pageId: pageIndex\n            questionIndex\n            fieldIndex\n            choice\n            sectionIndex\n            condition\n            fieldType\n            value\n            __typename\n          }\n          showIfAny {\n            pageId: pageIndex\n            questionIndex\n            fieldIndex\n            choice\n            sectionIndex\n            __typename\n          }\n          showIfAll {\n            pageId: pageIndex\n            questionIndex\n            fieldIndex\n            choice\n            sectionIndex\n            condition\n            fieldType\n            value\n            __typename\n          }\n          fieldGroups {\n            isAcceptableFormID\n            modalHeadLabel\n            isBottomBoder\n            showIf {\n              pageId: pageIndex\n              questionIndex\n              fieldIndex\n              choice\n              choices\n              sectionIndex\n              condition\n              fieldType\n              value\n              __typename\n            }\n            showIfAny {\n              pageId: pageIndex\n              questionIndex\n              fieldIndex\n              choice\n              sectionIndex\n              condition\n              fieldType\n              value\n              __typename\n            }\n            field {\n              _id\n              fieldId\n              label\n              multiLingualChoices {\n                label\n                value\n                __typename\n              }\n              value\n              placeholder\n              isBackground\n              isCenterAlign\n              isGroupedLabels\n              isBackground\n              readonly\n              isGroupField\n              answerType {\n                _id\n                answerType\n                choicesAvailable\n                __typename\n              }\n              __typename\n            }\n            display {\n              flex\n              responsiveFlex\n              __typename\n            }\n            value\n            apiModelRef\n            apiModelRefSecondary\n            validation {\n              required\n              errorMessage\n              minLength\n              maxLength\n              __typename\n            }\n            __typename\n          }\n          __typename\n        }\n        __typename\n      }\n      showIfAny {\n        pageId: pageIndex\n        questionIndex\n        fieldIndex\n        choice\n        sectionIndex\n        condition\n        fieldType\n        value\n        __typename\n      }\n      showIfAll {\n        pageId: pageIndex\n        questionIndex\n        fieldIndex\n        choice\n        sectionIndex\n        condition\n        fieldType\n        value\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n}&quot;}</stringProp>
