            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument" enabled="true">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;center&quot;,&quot;variables&quot;:{&quot;id&quot;:&quot;${C_id}&quot;,&quot;coordinates&quot;:[33.8126059,-84.6343783]},&quot;query&quot;:&quot;query center($id: String!, $coordinates: [Float!]) {\n  getCenter(_id: $id, coordinates: $coordinates) {\n    _id\n    facilityName\n    facilityType\n    twilioNumber\n    telemedicineCenterId\n    isOcrEnabled\n    miles\n    slotCutOffTimeInMins\n    centerStatus\n    temporarilyStartDateTime\n    temporarilyClosedDateTime\n    comingSoonDateTime\n    ezPayNotAcceptedInsurance\n    configurableProperties {\n      isEPICFeatureEnabled\n      preVisit {\n        isPreVisitEnabled\n        isPreVisitEnabledForLast2hour\n        isPreVisitEnabledForWalkinOnly\n        __typename\n      }\n      checkInForm {\n        hideTimeSlotInfoInPA\n        __typename\n      }\n      selDepId\n      flowForSlotBooking\n      bookAheadSlotConfiguration {\n        showTomorrowSlots\n        todaySlotCutoffTime\n        __typename\n      }\n      slotBuffer {\n        isEnabled\n        bufferTimeInMinutes\n        __typename\n      }\n      __typename\n    }\n    address {\n      state\n      zipcode\n      address1\n      city\n      coordinates\n      landmark\n      clinicPhoneNumber\n      clinicFaxNumber\n      __typename\n    }\n    locale {\n      countryId\n      countryName\n      regionId\n      regionName\n      orgId\n      orgName\n      orgDisplayName\n      divisionId\n      divisionName\n      orgAccronym\n      __typename\n    }\n    insuranceCompany\n    insuranceNotAcceptedForCompany\n    workSchedule {\n      openingTime\n      closingTime\n      slotDuration\n      workingDaysOfWeek\n      __typename\n    }\n    timezone\n    __typename\n  }\n}&quot;}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="HTTPSampler.domain">${domins}</stringProp>
            <stringProp name="HTTPSampler.port">443</stringProp>
            <stringProp name="HTTPSampler.protocol"></stringProp>
            <stringProp name="HTTPSampler.contentEncoding">utf-8</stringProp>
            <stringProp name="HTTPSampler.path">/graphql/graphql</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
            <stringProp name="GraphQLHTTPSampler.operationName">center</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">query center($id: String!, $coordinates: [Float!]) {
  getCenter(_id: $id, coordinates: $coordinates) {
    _id
    facilityName
    facilityType
    twilioNumber
    telemedicineCenterId
    isOcrEnabled
    miles
    slotCutOffTimeInMins
    centerStatus
    temporarilyStartDateTime
    temporarilyClosedDateTime
    comingSoonDateTime
    ezPayNotAcceptedInsurance
    configurableProperties {
      isEPICFeatureEnabled
      preVisit {
        isPreVisitEnabled
        isPreVisitEnabledForLast2hour
        isPreVisitEnabledForWalkinOnly
        __typename
      }
      checkInForm {
        hideTimeSlotInfoInPA
        __typename
      }
      selDepId
      flowForSlotBooking
      bookAheadSlotConfiguration {
        showTomorrowSlots
        todaySlotCutoffTime
        __typename
      }
      slotBuffer {
        isEnabled
        bufferTimeInMinutes
        __typename
      }
      __typename
    }
    address {
      state
      zipcode
      address1
      city
      coordinates
      landmark
      clinicPhoneNumber
      clinicFaxNumber
      __typename
    }
    locale {
      countryId
      countryName
      regionId
      regionName
      orgId
      orgName
      orgDisplayName
      divisionId
      divisionName
      orgAccronym
      __typename
    }
    insuranceCompany
    insuranceNotAcceptedForCompany
    workSchedule {
      openingTime
      closingTime
      slotDuration
      workingDaysOfWeek
      __typename
    }
