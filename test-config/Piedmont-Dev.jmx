                __typename
              }
              value
              placeholder
              isBackground
              isCenterAlign
              isGroupedLabels
              isBackground
              readonly
              isGroupField
              answerType {
                _id
                answerType
                choicesAvailable
                __typename
              }
              __typename
            }
            display {
              flex
              responsiveFlex
              __typename
            }
            value
            apiModelRef
            apiModelRefSecondary
            validation {
              required
