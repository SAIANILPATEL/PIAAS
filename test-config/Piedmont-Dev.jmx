            <stringProp name="GraphQLHTTPSampler.operationName">getCentersByOrgWithSlots</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">query getCentersByOrgWithSlots($coordinates: [Float!], $orgId: String!, $date: DateTime!, $limit: Int, $skip: Int, $isNearest: Boolean!) {
  getCentersByOrgWithSlots(
    coordinates: $coordinates
    orgId: $orgId
    date: $date
    limit: $limit
    skip: $skip
    isNearest: $isNearest
  ) {
    totalCenterCount
    centerSlotOutput {
      center {
        _id
        centerStatus
        temporarilyStartDateTime
        temporarilyClosedDateTime
        comingSoonDateTime
        centerBlobUrl
        facilityName
        address {
          state
          zipcode
          address1
          city
          coordinates
          __typename
        }
        slotCutOffTimeInMins
        workSchedule {
          openingTime
          closingTime
          slotDuration
          workingDaysOfWeek
          __typename
        }
        timezone
        configurableProperties {
          isEPICFeatureEnabled
          preVisit {
            isPreVisitEnabled
            isPreVisitEnabledForLast2hour
            isPreVisitEnabledForWalkinOnly
            __typename
          }
          selDepId
          flowForSlotBooking
          bookAheadSlotConfiguration {
            showTomorrowSlots
            todaySlotCutoffTime
            __typename
          }
          slotBuffer {
            isEnabled
            bufferTimeInMinutes
            __typename
          }
          __typename
        }
        __typename
      }
      getAvailableSlots {
        computedSlots {
          slotForToday {
            startTimeInMins
            endTimeInMins
            date
            usedSlots
            isSlotQueueSelectionEnabled
            totalSlots
            offlineSlots
            onlineSlots
            usedOfflineSlots
            usedOnlineSlots
            availableSlots
            slotDuringHourList {
              slotStartTime
              slotEndTime
              label
              queue
              open
              selected
              isNow
              isAfterFiveMinutes
              isSlotAlreadyUsed
              __typename
            }
            __typename
          }
          slotForTomorrow {
            startTimeInMins
            endTimeInMins
            date
            usedSlots
            isSlotQueueSelectionEnabled
            totalSlots
            offlineSlots
            onlineSlots
            usedOfflineSlots
            usedOnlineSlots
            availableSlots
            slotDuringHourList {
              slotStartTime
              slotEndTime
              label
              queue
              open
              selected
              isNow
              isAfterFiveMinutes
              isSlotAlreadyUsed
              __typename
            }
            __typename
          }
          __typename
        }
        __typename
      }
      miles
      __typename
    }
    nearestCenterSlotOutput {
      center {
        _id
        centerStatus
        centerBlobUrl
        facilityName
