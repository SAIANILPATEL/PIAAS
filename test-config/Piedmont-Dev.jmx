                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;getCentersByOrgWithSlots&quot;,&quot;variables&quot;:{&quot;isNearest&quot;:true,&quot;orgId&quot;:&quot;${C_orgId}&quot;,&quot;date&quot;:&quot;${__time(YYYY-MM-dd&apos;T&apos;HH:mm:ss.SSS&apos;Z&apos;,)}&quot;,&quot;coordinates&quot;:[],&quot;limit&quot;:10},&quot;query&quot;:&quot;query getCentersByOrgWithSlots($coordinates: [Float!], $orgId: String!, $date: DateTime!, $limit: Int, $skip: Int, $isNearest: Boolean!) {\n  getCentersByOrgWithSlots(\n    coordinates: $coordinates\n    orgId: $orgId\n    date: $date\n    limit: $limit\n    skip: $skip\n    isNearest: $isNearest\n  ) {\n    totalCenterCount\n    centerSlotOutput {\n      center {\n        _id\n        centerStatus\n        temporarilyStartDateTime\n        temporarilyClosedDateTime\n        comingSoonDateTime\n        centerBlobUrl\n        facilityName\n        address {\n          state\n          zipcode\n          address1\n          city\n          coordinates\n          __typename\n        }\n        slotCutOffTimeInMins\n        workSchedule {\n          openingTime\n          closingTime\n          slotDuration\n          workingDaysOfWeek\n          __typename\n        }\n        timezone\n        configurableProperties {\n          isEPICFeatureEnabled\n          preVisit {\n            isPreVisitEnabled\n            isPreVisitEnabledForLast2hour\n            isPreVisitEnabledForWalkinOnly\n            __typename\n          }\n          selDepId\n          flowForSlotBooking\n          bookAheadSlotConfiguration {\n            showTomorrowSlots\n            todaySlotCutoffTime\n            __typename\n          }\n          slotBuffer {\n            isEnabled\n            bufferTimeInMinutes\n            __typename\n          }\n          __typename\n        }\n        __typename\n      }\n      getAvailableSlots {\n        computedSlots {\n          slotForToday {\n            startTimeInMins\n            endTimeInMins\n            date\n            usedSlots\n            isSlotQueueSelectionEnabled\n            totalSlots\n            offlineSlots\n            onlineSlots\n            usedOfflineSlots\n            usedOnlineSlots\n            availableSlots\n            slotDuringHourList {\n              slotStartTime\n              slotEndTime\n              label\n              queue\n              open\n              selected\n              isNow\n              isAfterFiveMinutes\n              isSlotAlreadyUsed\n              __typename\n            }\n            __typename\n          }\n          slotForTomorrow {\n            startTimeInMins\n            endTimeInMins\n            date\n            usedSlots\n            isSlotQueueSelectionEnabled\n            totalSlots\n            offlineSlots\n            onlineSlots\n            usedOfflineSlots\n            usedOnlineSlots\n            availableSlots\n            slotDuringHourList {\n              slotStartTime\n              slotEndTime\n              label\n              queue\n              open\n              selected\n              isNow\n              isAfterFiveMinutes\n              isSlotAlreadyUsed\n              __typename\n            }\n            __typename\n          }\n          __typename\n        }\n        __typename\n      }\n      miles\n      __typename\n    }\n    nearestCenterSlotOutput {\n      center {\n        _id\n        centerStatus\n        centerBlobUrl\n        facilityName\n        address {\n          state\n          zipcode\n          address1\n          city\n          coordinates\n          __typename\n        }\n        slotCutOffTimeInMins\n        workSchedule {\n          openingTime\n          closingTime\n          slotDuration\n          workingDaysOfWeek\n          __typename\n        }\n        timezone\n        configurableProperties {\n          preVisit {\n            isPreVisitEnabled\n            isPreVisitEnabledForLast2hour\n            isPreVisit