                label
                value
                __typename
              }
              value
              placeholder
              isBackground
              isCenterAlign
              isGroupedLabels
              isBackground
              readonly
              isGroupField
              answerType {
                _id
                answerType
                choicesAvailable
                __typename
              }
              __typename
            }
            display {
              flex
              responsiveFlex
              __typename
            }
            value
            apiModelRef
            apiModelRefSecondary
            validation {
              required
              errorMessage
              minLength
              maxLength
              __typename
            }
            showIf {
              pageId: pageIndex
              questionIndex
              fieldIndex
              choice
              sectionIndex
              condition
              fieldType
              value
              __typename
            }
            showIfAny {
              pageId: pageIndex
              questionIndex
              fieldIndex
              choice
              sectionIndex
              __typename
            }
            showIfAll {
              pageId: pageIndex
              questionIndex
              fieldIndex
