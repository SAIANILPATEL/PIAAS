            usedOfflineSlots
            usedOnlineSlots
            availableSlots
            slotDuringHourList {
              slotStartTime
              slotEndTime
              label
              queue
              open
              selected
              isNow
              isAfterFiveMinutes
              isSlotAlreadyUsed
              __typename
            }
            __typename
          }
          slotForTomorrow {
            startTimeInMins
            endTimeInMins
            date
            usedSlots
            isSlotQueueSelectionEnabled
            totalSlots
            offlineSlots
            onlineSlots
            usedOfflineSlots
            usedOnlineSlots
            availableSlots
            slotDuringHourList {
              slotStartTime
              slotEndTime
              label
              queue
              open
              selected
              isNow
              isAfterFiveMinutes
              isSlotAlreadyUsed
              __typename
            }
            __typename
          }
          __typename
        }
        __typename
      }
      miles
      __typename
    }
    nearestCenterSlotOutput {
      center {
        _id
        centerStatus
