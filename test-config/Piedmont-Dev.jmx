      }
      slotForTomorrow {
        startTimeInMins
        date
        endTimeInMins
        slotDuringHourList {
          label
          slotStartTime
          slotEndTime
          queue
          isDynamicallyAdded
          __typename
        }
        __typename
      }
      __typename
    }
    __typename
  }
}</stringProp>
