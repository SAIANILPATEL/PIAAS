tEnabledForLast2hour\n        isPreVisitEnabledForWalkinOnly\n        __typename\n      }\n      checkInForm {\n        hideTimeSlots\n        disableTimeSlots\n        defaultNextAvailableSlot\n        hideTimeSlotInfoInPA\n        hideTomorrowSlotInEA\n        __typename\n      }\n      selDepId\n      employerServiceTypes\n      slotBuffer {\n        isEnabled\n        bufferTimeInMinutes\n        __typename\n      }\n      retainHoverStateOfCalendar\n      isEnableInsuranceNavTab\n      isEnableVisitCancellationFlow\n      isHideAllTabQueueSection\n      dynamicSlotReopening {\n        completed {\n          isEnabled\n          isWalkInOnly\n          timeframeInMins\n          reason\n          __typename\n        }\n        cancelled {\n          isEnabled\n          isWalkInOnly\n          timeframeInMins\n          reason\n          __typename\n        }\n        __typename\n      }\n      showDXPAssist\n      slotPreferenceEnabled\n      __typename\n    }\n    telemedicineCenterId\n    isOcrEnabled\n    isTransferEnabled\n    isTransferEnabled\n    address {\n      state\n      zipcode\n      address1\n      city\n      coordinates\n      clinicPhoneNumber\n      clinicFaxNumber\n      landmark\n      __typename\n    }\n    locale {\n      countryId\n      countryName\n      regionId\n      regionName\n      orgId\n      orgName\n      orgDisplayName\n      divisionId\n      divisionName\n      orgAccronym\n      __typename\n    }\n    insuranceCompany\n    insuranceNotAcceptedForCompany\n    workSchedule {\n      openingTime\n      closingTime\n      slotDuration\n      workingDaysOfWeek\n      slots {\n        startTimeInMins\n        endTimeInMins\n        totalSlots\n        requestedSlots\n        canceledSlots\n        availableSlots\n        isOpenToPatientApp\n        isSlotQueueSelectionEnabled\n        offlineSlots\n        onlineSlots\n        dynamicSlotAddition {\n          dynamicAdditionBuffer\n          __typename\n        }\n        prioritizeWalkIn\n        bookAheadSlotPreference {\n          enabled\n          bookAheadTimeFrameInMinutes\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    slotConfiguration {\n      startTimeInMins\n      endTimeInMins\n      noOfSlots\n      isToday\n      __typename\n    }\n    facilityAccronym\n    timezone\n    centerStatus\n    temporarilyClosedDateTime\n    temporarilyStartDateTime\n    comingSoonDateTime\n    operationalStartDate\n    __typename\n  }\n}&quot;}</stringProp>
