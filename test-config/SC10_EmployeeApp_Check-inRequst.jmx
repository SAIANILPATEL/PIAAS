ins\n        endTimeInMins\n        date\n        usedSlots\n        isSlotQueueSelectionEnabled\n        totalSlots\n        offlineSlots\n        onlineSlots\n        usedOfflineSlots\n        usedOnlineSlots\n        availableSlots\n        blockedSlots {\n          requestedSlots\n          appointmentDate\n          appointmentTimeInMins\n          slotQueue\n          blockedSlotUuid\n          uuid\n          __typename\n        }\n        slotDuringHourList {\n          slotStartTime\n          slotEndTime\n          label\n          queue\n          open\n          selected\n          isNow\n          isAfterFiveMinutes\n          isSlotAlreadyUsed\n          isDynamicallyAdded\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n}&quot;}</stringProp>
