    isFollowUpTelemedVisitCovidOnly
    isFollowUpTelemedVisit
    consent {
      consentToTreat
      consentToFinanicalResposibity
      consentToReleaseInformation
      consentToChildProxy
      consentToPrivacy
      consentToSelfPay
      consentToTeleMedicine
      __typename
    }
    rcmPayment {
      patientResponsibility {
        isAmountToBeCollected
        isTypeCopay
        isTypeCoInsurance
        isTypeDeductible
        isTypeSelfPay
        paymentType {
          coPay {
            isAmountToBeCollected
            amount
            collected
            isCollected
            __typename
          }
          deductible {
            isAmountToBeCollected
            amount
            collected
            isCollected
            __typename
          }
          selfPay {
            isAmountToBeCollected
            amount
            collected
            isCollected
            __typename
          }
          __typename
        }
        amount
        comments
        isTotalAmountCollected
        collectedAmount
        commentsAtCollection
        isResponsibilityPaidPartially
        reasonForNotPaying
        otherReasonCommentForPatientResponsibility
        __typename
      }
      patientOutstanding {
        isOutstandingBalance
        amount
        comments
        isTotalOutstandingCollected
        collectedAmount
        commentsAtCollection
        isOutstandingPaidPartially
        reasonForNotPaying
        otherReasonCommentForOutstanding
        __typename
