           __typename\n          }\n          showIfAny {\n            pageIndex\n            questionIndex\n            fieldIndex\n            choice\n            sectionIndex\n            __typename\n          }\n          fieldGroups {\n            field {\n              _id\n              fieldId\n              label\n              choices\n              value\n              placeholder\n              answerType {\n                _id\n                answerType\n                choicesAvailable\n                __typename\n              }\n              __typename\n            }\n            display {\n              flex\n              __typename\n            }\n            value\n            apiModelRef\n            apiModelRefSecondary\n            validation {\n              required\n              errorMessage\n              minLength\n              maxLength\n              __typename\n            }\n            __typename\n          }\n          __typename\n        }\n        __typename\n      }\n      showIfAny {\n        pageIndex\n        questionIndex\n        fieldIndex\n        choice\n        sectionIndex\n        condition\n        fieldType\n        value\n        __typename\n      }\n      showIfAll {\n        pageIndex\n        questionIndex\n        fieldIndex\n        choice\n        sectionIndex\n        condition\n        fieldType\n        value\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n}&quot;}</stringProp>
