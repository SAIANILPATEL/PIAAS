            <stringProp name="GraphQLHTTPSampler.query">query getSlots($centerId: String!, $date: DateTime!) {
  getSlots(centerId: $centerId, date: $date) {
    _id
    centerId
    date
    slots {
      startTimeInMins
      endTimeInMins
      totalSlots
      requestedSlots
      canceledSlots
      availableSlots
      isOpenToPatientApp
      usedSlots
      isSlotQueueSelectionEnabled
      schema_version
      offlineSlots
      onlineSlots
      usedOfflineSlots
      usedOnlineSlots
      isExtraHourOfClinic
      blockedSlots {
        slotQueue
        createdTimeStamp
        __typename
      }
      dynamicSlotAddition {
        cancelled {
          reason
          action
          totalSlots
          offlineSlots
          onlineSlots
          visits {
            _id
            phoneNumber
            visitAppointment {
              date
              startTimeInMins
              endTimeInMins
              slotQueue
              slotStartTime
              slotEndTime
              reasonForReschedule
              __typename
            }
            patientInfo {
              patientId
              firstName
              lastName
              middleName
              fullName
              preferredName
              dateOfBirth
              sex
              language
              isMarried
              ethnicity
              race
              ssn
              __typename
            }
            __typename
          }
          __typename
        }
        completed {
          reason
          action
          totalSlots
          offlineSlots
          onlineSlots
          visits {
            _id
            phoneNumber
            visitAppointment {
              date
              startTimeInMins
              endTimeInMins
              slotQueue
              slotStartTime
              slotEndTime
              reasonForReschedule
              __typename
            }
            patientInfo {
              patientId
              firstName
              lastName
              middleName
              fullName
              preferredName
              dateOfBirth
              sex
              language
              isMarried
              ethnicity
              race
              ssn
              __typename
            }
            __typename
          }
          __typename
        }
        unused {
          totalSlots
          lastUpdated
          __typename
        }
        dynamicAdditionBuffer
        __typename
      }
      prioritizeWalkIn
      bookAheadSlotPreference {
        enabled
        bookAheadTimeFrameInMinutes
        __typename
      }
      addedDynamicSlots
      usedDynamicSlots
      __typename
    }
    slotAudit {
      slotEditId
      slotEditingStartedAt
      isEditingCompleted
      timeStamp
      actionTakenBy
      actionTakenByEmail
      __typename
    }
    __typename
  }
}
</stringProp>
