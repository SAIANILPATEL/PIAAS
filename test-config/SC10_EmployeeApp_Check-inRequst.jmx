      user
      userEmail
      date
      editId
      editingStartedAt
      isEditingCompleted
      olderData
      updatedData
      field
      __typename
    }
    twilioNumber
    isWaitTimeEnabled
    ezPayNotAcceptedInsurance
    slotCutOffTimeInMins
