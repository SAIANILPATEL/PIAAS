      isEpicWorkGroupEnabled
      isEPICFeatureEnabled
      isSMSAndReportsAreDisabled
      bookAheadSlotConfiguration {
        todaySlotCutoffTime
        showTomorrowSlots
        bookAheadCutoffEnabled
        ignoreTimeForBookAheadCutoff
        __typename
      }
      isRCMBillingEnabledThroughQueue
      isProfileViewEnabled
      isRCMBillingEnabledThroughProfile
      isNewRCMBillingEnabled
      isEmailCheckEnabled
      isDelayTimeNotificationEnabled
      delayTimeNotificationFrequencyInMinutes
      autoCancellationWaitTimeInMinutes
      reasonForVisit
      occMedVisitTypes
      checkInFormOptions
      birdEyeId
      isAutoCancellationEnabledForTelemed
      waitTimeForSmsBeforeCancellation
      isAgilityCheckEnabled
      showAddressIn2Lines
      isAddressCapitalized
      addressFirstLineApt
      showCancellationPrediction
      isAutoTimerSMSNotificationEnabled
      notification {
        name
        code
        emailSubscribed
        smsSubscribed
        __typename
      }
      isNewUISupported
      isLaunched
      isCardOnFileEnabled
      authorization {
        supportsEmployerPortal
        supportsBilling
        __typename
      }
      preVisit {
        isPreVisitEnabled
        isPreVisitEnabledForLast2hour
        isPreVisitEnabledForWalkinOnly
        __typename
      }
      checkInForm {
        hideTimeSlots
        disableTimeSlots
        defaultNextAvailableSlot
        hideTimeSlotInfoInPA
        hideTomorrowSlotInEA
        __typename
      }
      selDepId
      employerServiceTypes
      slotBuffer {
        isEnabled
        bufferTimeInMinutes
        __typename
      }
      retainHoverStateOfCalendar
      isEnableInsuranceNavTab
      isEnableVisitCancellationFlow
      isHideAllTabQueueSection
      dynamicSlotReopening {
        completed {
          isEnabled
          isWalkInOnly
          timeframeInMins
          reason
          __typename
        }
        cancelled {
          isEnabled
          isWalkInOnly
          timeframeInMins
          reason
          __typename
        }
        __typename
      }
      showDXPAssist
      slotPreferenceEnabled
      __typename
    }
    telemedicineCenterId
    isOcrEnabled
    isTransferEnabled
    isTransferEnabled
    address {
      state
      zipcode
      address1
      city
      coordinates
      clinicPhoneNumber
      clinicFaxNumber
      landmark
      __typename
    }
    locale {
      countryId
      countryName
      regionId
      regionName
      orgId
      orgName
      orgDisplayName
      divisionId
      divisionName
      orgAccronym
      __typename
    }
    insuranceCompany
    insuranceNotAcceptedForCompany
    workSchedule {
      openingTime
      closingTime
      slotDuration
      workingDaysOfWeek
      slots {
        startTimeInMins
        endTimeInMins
        totalSlots
        requestedSlots
        canceledSlots
        availableSlots
        isOpenToPatientApp
        isSlotQueueSelectionEnabled
        offlineSlots
        onlineSlots
        dynamicSlotAddition {
          dynamicAdditionBuffer
          __typename
        }
        prioritizeWalkIn
        bookAheadSlotPreference {
          enabled
          bookAheadTimeFrameInMinutes
          __typename
        }
        __typename
      }
      __typename
    }
    slotConfiguration {
      startTimeInMins
      endTimeInMins
      noOfSlots
      isToday
      __typename
    }
    facilityAccronym
    timezone
    centerStatus
    temporarilyClosedDateTime
    temporarilyStartDateTime
    comingSoonDateTime
    operationalStartDate
    __typename
  }
}
</stringProp>
