yForm {\n      firstName\n      lastName\n      middleName\n      preferredName\n      dateOfBirth\n      phoneNumber\n      email\n      address1\n      address2\n      state\n      city\n      zipCode\n      primaryClinic\n      __typename\n    }\n    childProxyConsent {\n      firstName\n      consentToChart\n      signature\n      __typename\n    }\n    medicalRecordDiscloser {\n      relationship\n      relationshipOther\n      firstName\n      lastName\n      phoneNumber\n      medicalDisclosurePhoneNumber\n      phoneConsent\n      email\n      emailConsent\n      __typename\n    }\n    iAmHere\n    currentStatusCode\n    symptoms\n    __typename\n  }\n}&quot;}</stringProp>
