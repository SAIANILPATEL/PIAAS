            <stringProp name="GraphQLHTTPSampler.query">query getAvailableSlotsForEmployee($date: DateTime!, $centerId: String!) {
  getAvailableSlotsForEmployee(date: $date, centerId: $centerId) {
    nextSlotForToday {
      startTimeInMins
      endTimeInMins
      date
      usedSlots
      isSlotQueueSelectionEnabled
      isExtraHourOfClinic
      blockedSlots {
        requestedSlots
        appointmentDate
        appointmentTimeInMins
        slotQueue
        blockedSlotUuid
        uuid
        __typename
      }
      slotDuringHourList {
        slotStartTime
        slotEndTime
        label
        queue
        open
        selected
        isNow
        isAfterFiveMinutes
        isSlotAlreadyUsed
        isDynamicallyAdded
        __typename
      }
      __typename
    }
    otherSlotForToday {
      startTimeInMins
      endTimeInMins
      date
      usedSlots
      isSlotQueueSelectionEnabled
      isExtraHourOfClinic
      blockedSlots {
        requestedSlots
        appointmentDate
        appointmentTimeInMins
        slotQueue
        blockedSlotUuid
        uuid
        __typename
      }
      slotDuringHourList {
        slotStartTime
        slotEndTime
        label
        queue
        open
        selected
        isNow
        isAfterFiveMinutes
        isSlotAlreadyUsed
        isDynamicallyAdded
        __typename
      }
      __typename
    }
    otherSlotForTomorrow {
      startTimeInMins
      endTimeInMins
      date
      usedSlots
      isSlotQueueSelectionEnabled
      isExtraHourOfClinic
      blockedSlots {
        requestedSlots
        appointmentDate
        appointmentTimeInMins
        slotQueue
        blockedSlotUuid
        uuid
        __typename
      }
      slotDuringHourList {
        slotStartTime
        slotEndTime
        label
        queue
        open
        selected
        isNow
        isAfterFiveMinutes
        isSlotAlreadyUsed
        isDynamicallyAdded
        __typename
      }
      __typename
    }
    computedSlots {
      slotForCurrentHour {
        startTimeInMins
        endTimeInMins
        date
        usedSlots
        isSlotQueueSelectionEnabled
        totalSlots
        offlineSlots
        onlineSlots
        usedOfflineSlots
        usedOnlineSlots
        availableSlots
        blockedSlots {
          requestedSlots
          appointmentDate
          appointmentTimeInMins
          slotQueue
          blockedSlotUuid
          uuid
          __typename
        }
        slotDuringHourList {
          slotStartTime
          slotEndTime
          label
          queue
          open
          selected
          isNow
          isAfterFiveMinutes
          isSlotAlreadyUsed
          isDynamicallyAdded
          __typename
        }
        __typename
      }
      slotForToday {
        startTimeInMins
        endTimeInMins
        date
        usedSlots
        isSlotQueueSelectionEnabled
        totalSlots
        offlineSlots
        onlineSlots
        usedOfflineSlots
        usedOnlineSlots
        availableSlots
        blockedSlots {
          requestedSlots
          appointmentDate
          appointmentTimeInMins
          slotQueue
          blockedSlotUuid
          uuid
          __typename
        }
        slotDuringHourList {
          slotStartTime
          slotEndTime
          label
          queue
          open
          selected
          isNow
          isAfterFiveMinutes
          isSlotAlreadyUsed
          isDynamicallyAdded
          __typename
        }
        __typename
      }
      slotForTomorrow {
        startTimeInMins
        endTimeInMins
        date
        usedSlots
        isSlotQueueSelectionEnabled
        totalSlots
        offlineSlots
        onlineSlots
        usedOfflineSlots
        usedOnlineSlots
        availableSlots
        blockedSlots {
          requestedSlots
          appointmentDate
          appointmentTimeInMins
          slotQueue
          blockedSlotUuid
          uuid
          __typename
        }
        slotDuringHourList {
          slotStartTime
