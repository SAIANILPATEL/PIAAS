                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;getRegistrationTemplate&quot;,&quot;variables&quot;:{&quot;formTemplateName&quot;:&quot;Piedmont Registration Template&quot;,&quot;lang&quot;:&quot;en&quot;,&quot;centerId&quot;:&quot;${C_id}&quot;,&quot;isNewFormTemplate&quot;:false},&quot;query&quot;:&quot;query getRegistrationTemplate($formTemplateName: String!, $lang: String!, $centerId: String!, $isNewFormTemplate: Boolean) {\n  formTemplate(\n    formTemplateName: $formTemplateName\n    lang: $lang\n    centerId: $centerId\n    isNewFormTemplate: $isNewFormTemplate\n  ) {\n    _id\n    formTemplateName\n    version\n    pages {\n      pageId\n      pageName\n      stepName\n      updateFlag {\n        apiModelRef\n        __typename\n      }\n      showIf {\n        pageIndex\n        questionIndex\n        fieldIndex\n        choice\n        sectionIndex\n        condition\n        fieldType\n        value\n        __typename\n      }\n      section {\n        showIf {\n          pageIndex\n          questionIndex\n          fieldIndex\n          choice\n          sectionIndex\n          __typename\n        }\n        footer {\n          message\n          showIf {\n            pageIndex\n            questionIndex\n            fieldIndex\n            choice\n            sectionIndex\n            __typename\n          }\n          __typename\n        }\n        header {\n          message\n          showIf {\n            pageIndex\n            questionIndex\n            fieldIndex\n            choice\n            sectionIndex\n            __typename\n          }\n          __typename\n        }\n        questions {\n          label\n          labelHeader\n          labelHtml\n          hint\n          help\n          indicate\n          showIf {\n            pageIndex\n            questionIndex\n            fieldIndex\n            choice\n            sectionIndex\n            condition\n            fieldType\n            value\n            __typename\n          }\n          showIfAny {\n            pageIndex\n            questionIndex\n            fieldIndex\n            choice\n            sectionIndex\n            __typename\n          }\n          fieldGroups {\n            field {\n              _id\n              fieldId\n              label\n              choices\n              value\n              placeholder\n              answerType {\n                _id\n                answerType\n                choicesAvailable\n                __typename\n              }\n              __typename\n            }\n            display {\n              flex\n              __typename\n            }\n            value\n            apiModelRef\n            apiModelRefSecondary\n            validation {\n              required\n              errorMessage\n              minLength\n              maxLength\n              __typename\n            }\n            __typename\n          }\n          __typename\n        }\n        __typename\n      }\n      showIfAny {\n        pageIndex\n        questionIndex\n        fieldIndex\n        choice\n        sectionIndex\n        condition\n        fieldType\n        value\n        __typename\n      }\n      showIfAll {\n        pageIndex\n        questionIndex\n        fieldIndex\n        choice\n        sectionIndex\n        condition\n        fieldType\n        value\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n}&quot;}</stringProp>
