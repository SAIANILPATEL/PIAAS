            <stringProp name="GraphQLHTTPSampler.operationName">getCenterZoneForPastDays</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">query getCenterZoneForPastDays($centerId: String!, $timeZone: String, $date: DateTime!, $lastDays: Float!) {
  getCenterZoneForPastDays(
    centerId: $centerId
    timeZone: $timeZone
    date: $date
    lastDays: $lastDays
  ) {
    today {
      _id
      hour
      centerInfo {
        centerId
        facilityName
        providerName
        orgName
        divisionName
        regionName
        __typename
      }
      timestamp
      createdDateTime
      zone
      visitCount
      label
      isEndOfTheDay
      __typename
    }
    past {
      _id
      hour
      centerInfo {
        centerId
        facilityName
        providerName
        orgName
        divisionName
        regionName
        __typename
      }
      timestamp
      createdDateTime
      zone
      visitCount
      label
      isEndOfTheDay
      __typename
    }
    __typename
  }
}
