           date\n              startTimeInMins\n              endTimeInMins\n              slotQueue\n              slotStartTime\n              slotEndTime\n              reasonForReschedule\n              __typename\n            }\n            patientInfo {\n              patientId\n              firstName\n              lastName\n              middleName\n              fullName\n              preferredName\n              dateOfBirth\n              sex\n              language\n              isMarried\n              ethnicity\n              race\n              ssn\n              __typename\n            }\n            __typename\n          }\n          __typename\n        }\n        unused {\n          totalSlots\n          lastUpdated\n          __typename\n        }\n        dynamicAdditionBuffer\n        __typename\n      }\n      prioritizeWalkIn\n      bookAheadSlotPreference {\n        enabled\n        bookAheadTimeFrameInMinutes\n        __typename\n      }\n      addedDynamicSlots\n      usedDynamicSlots\n      __typename\n    }\n    slotAudit {\n      slotEditId\n      slotEditingStartedAt\n      isEditingCompleted\n      timeStamp\n      actionTakenBy\n      actionTakenByEmail\n      __typename\n    }\n    __typename\n  }\n}&quot;}</stringProp>
