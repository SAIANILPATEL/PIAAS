            <stringProp name="GraphQLHTTPSampler.query">query getVisits($centerId: String!, $date: DateTime!) {
  getVisits(centerId: $centerId, date: $date) {
    _id
    checkinLocation
    channel
    visitCreatedIn
    email
    mrn
    isPatientFoundInEpicRecord
    symptoms
    reasonForVisit
    phoneNumber
    createdDateTime
    updatedDateTime
    isEpic
    isPhotoIdCopyAvailable
    isInsuranceIdCopyAvailable
    isFollowUpVisit
    isFollowUpCreated
    isEpicDFDPatientBalanceEnabled
    visitCancellationPrediction {
      dfdVisitId
      cancellation_prob
      process_time
      __typename
    }
    campaigns {
      campaignKey
      campaignActions {
        actionType
        actionCompleted
        __typename
      }
      __typename
    }
    isEpicReminderSent
    occMedNewCompany
    occMed {
      employerServiceType
      workCompType
      authorizationLetterUri {
        front {
          name
          uri
          __typename
        }
        __typename
      }
      authorizationFromValid
      companyName
      companyPhone
      companySupContactName
      companySupContactEmail
      companyAddress
      __typename
    }
    patientInfo {
      patientId
      firstName
      lastName
      dateOfBirth
      __typename
    }
    contactDetails {
      phoneNumber
      email
      __typename
    }
    insuranceInfo {
      insuranceCompany
      isInsurancePlanIsNotAccepted
      insurancePlan
      __typename
    }
    appointment {
      date
      startTimeInMins
      endTimeInMins
      slotQueue
      isDynamicallyAdded
      __typename
    }
    registrationChecks {
      identity
      forms
      insurance
      medicare
      patientDetails
      contactDetails
      insuranceDetails
      medicare
      insuranceHolder
      financialResponsibility
      condOfServAndConsentToTreat
      patientFinancialResponsibility
      authToReleaseInfo
      ackOfRightsAndPrivacy
      medicalRecordDiscloser
      childProxyForm
      childProxyConsent
      __typename
    }
    iAmHere
    isVisitConfirmed
    notes {
      comments
      timeStamp
      notesBy
      hasNew
      email
      __typename
    }
    centerInfo {
      centerId
      facilityName
      providerName
      orgName
      __typename
    }
    reason
    isNewVisit
    preVisitId
    anyOtherReason
    visitTypePhysical
    dateOfInjury
    visitAudit {
      timeStamp
      actionTakenBy
      field
      fieldAudit {
        fieldName
        oldValue
        newValue
        __typename
      }
      __typename
    }
    delayTime {
      delayedByInMinutes
      actualDelayTime
      inExamDelay
      __typename
    }
    isNewPatientApp
    priority
    idMismatchInfo
    insuranceMismatchInfo
    currentStatusCode
    attendedBy
    isAdhocVisit
    isNurseVisit
    isTelemedVisit
    currentSubStatusCode
    consentToSMSNotification
    visitType
    isOccMedVisit
    employeeServiceType
    inExamAttendedBy {
      _id
      attendedBy
      userJoined
      isUserEverJoined
      isVideoLinkShared
      isClaimed
      providerJoined
      isProviderEverJoined
      isUserEncounteredError
      userSessionAudit
      isProviderEncounteredError
      notes {
        comments
        timeStamp
        notesBy
        email
        __typename
      }
      __typename
    }
    isFollowUpPhysicalVisit
    isInClinicProviderVisitRequired
    isFollowUpTelemedVisitCovidOnly
    isFollowUpTelemedVisit
    consent {
      consentToTreat
      consentToFinanicalResposibity
      consentToReleaseInformation
      consentToChildProxy
      consentToPrivacy
      consentToSelfPay
      consentToTeleMedicine
      __typename
    }
    rcmPayment {
      patientResponsibility {
        isAmountToBeCollected
        isTypeCopay
        isTypeCoInsurance
        isTypeDeductible
        isTypeSelfPay
        paymentType {
          coPay {
            isAmountToBeCollected
            amount
            collected
            isCollected
            __typename
          }
          deductible {
            isAmountToBeCollected
            amount
            collected
            isCollected
            __typename
          }
          selfPay {
            isAmountToBeCollected
            amount
            collected
            isCollected
            __typename
          }
          __typename
        }
        amount
        comments
        isTotalAmountCollected
        collectedAmount
        commentsAtCollection
        isResponsibilityPaidPartially
        reasonForNotPaying
        otherReasonCommentForPatientResponsibility
        __typename
      }
      patientOutstanding {
        isOutstandingBalance
        amount
        comments
        isTotalOutstandingCollected
        collectedAmount
        commentsAtCollection
        isOutstandingPaidPartially
        reasonForNotPaying
        otherReasonCommentForOutstanding
        __typename
      }
      timeStamp
      billedBy
      collectedBy
      responsibilityDeniedReason
      responsibilityDeniedOtherReason
      isCOFCardDetailForEMREnabled
      eMRCardDetailReason
      eMRCardDetailOtherReason
      __typename
    }
    __typename
  }
}
</stringProp>
