            <stringProp name="GraphQLHTTPSampler.query">query getRegistrationTemplate($formTemplateName: String!, $lang: String!, $centerId: String!, $isNewFormTemplate: Boolean) {
  formTemplate(
    formTemplateName: $formTemplateName
    lang: $lang
    centerId: $centerId
    isNewFormTemplate: $isNewFormTemplate
  ) {
    _id
    formTemplateName
    version
    pages {
      pageId
      pageName
      stepName
      updateFlag {
        apiModelRef
        __typename
      }
      showIf {
        pageIndex
        questionIndex
        fieldIndex
        choice
        sectionIndex
        condition
        fieldType
        value
        __typename
      }
      section {
        showIf {
          pageIndex
          questionIndex
          fieldIndex
          choice
          sectionIndex
          __typename
        }
        footer {
          message
          showIf {
            pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            __typename
          }
          __typename
        }
        header {
          message
          showIf {
            pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            __typename
          }
          __typename
        }
        questions {
          label
          labelHeader
          labelHtml
          hint
          help
          indicate
          showIf {
            pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            condition
            fieldType
            value
            __typename
          }
          showIfAny {
            pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            __typename
          }
          fieldGroups {
            field {
              _id
              fieldId
              label
              choices
              value
              placeholder
              answerType {
                _id
                answerType
                choicesAvailable
                __typename
              }
              __typename
            }
            display {
              flex
              __typename
            }
            value
            apiModelRef
            apiModelRefSecondary
            validation {
              required
              errorMessage
              minLength
              maxLength
              __typename
            }
            __typename
          }
          __typename
        }
        __typename
      }
      showIfAny {
        pageIndex
        questionIndex
        fieldIndex
        choice
        sectionIndex
        condition
        fieldType
        value
        __typename
      }
      showIfAll {
        pageIndex
        questionIndex
        fieldIndex
        choice
        sectionIndex
        condition
        fieldType
        value
        __typename
      }
      __typename
    }
    __typename
  }
}
</stringProp>
