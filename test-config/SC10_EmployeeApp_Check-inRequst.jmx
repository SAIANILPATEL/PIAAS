                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;getAvailableSlotsForEmployee&quot;,&quot;variables&quot;:{&quot;centerId&quot;:&quot;${C_id}&quot;,&quot;date&quot;:&quot;${__timeShift(YYYY-MM-dd,,P1D,,)}T04:00:00.000Z&quot;},&quot;query&quot;:&quot;query getAvailableSlotsForEmployee($date: DateTime!, $centerId: String!) {\n  getAvailableSlotsForEmployee(date: $date, centerId: $centerId) {\n    nextSlotForToday {\n      startTimeInMins\n      endTimeInMins\n      date\n      usedSlots\n      isSlotQueueSelectionEnabled\n      isExtraHourOfClinic\n      blockedSlots {\n        requestedSlots\n        appointmentDate\n        appointmentTimeInMins\n        slotQueue\n        blockedSlotUuid\n        uuid\n        __typename\n      }\n      slotDuringHourList {\n        slotStartTime\n        slotEndTime\n        label\n        queue\n        open\n        selected\n        isNow\n        isAfterFiveMinutes\n        isSlotAlreadyUsed\n        isDynamicallyAdded\n        __typename\n      }\n      __typename\n    }\n    otherSlotForToday {\n      startTimeInMins\n      endTimeInMins\n      date\n      usedSlots\n      isSlotQueueSelectionEnabled\n      isExtraHourOfClinic\n      blockedSlots {\n        requestedSlots\n        appointmentDate\n        appointmentTimeInMins\n        slotQueue\n        blockedSlotUuid\n        uuid\n        __typename\n      }\n      slotDuringHourList {\n        slotStartTime\n        slotEndTime\n        label\n        queue\n        open\n        selected\n        isNow\n        isAfterFiveMinutes\n        isSlotAlreadyUsed\n        isDynamicallyAdded\n        __typename\n      }\n      __typename\n    }\n    otherSlotForTomorrow {\n      startTimeInMins\n      endTimeInMins\n      date\n      usedSlots\n      isSlotQueueSelectionEnabled\n      isExtraHourOfClinic\n      blockedSlots {\n        requestedSlots\n        appointmentDate\n        appointmentTimeInMins\n        slotQueue\n        blockedSlotUuid\n        uuid\n        __typename\n      }\n      slotDuringHourList {\n        slotStartTime\n        slotEndTime\n        label\n        queue\n        open\n        selected\n        isNow\n        isAfterFiveMinutes\n        isSlotAlreadyUsed\n        isDynamicallyAdded\n        __typename\n      }\n      __typename\n    }\n    computedSlots {\n      slotForCurrentHour {\n        startTimeInMins\n        endTimeInMins\n        date\n        usedSlots\n        isSlotQueueSelectionEnabled\n        totalSlots\n        offlineSlots\n        onlineSlots\n        usedOfflineSlots\n        usedOnlineSlots\n        availableSlots\n        blockedSlots {\n          requestedSlots\n          appointmentDate\n          appointmentTimeInMins\n          slotQueue\n          blockedSlotUuid\n          uuid\n          __typename\n        }\n        slotDuringHourList {\n          slotStartTime\n          slotEndTime\n          label\n          queue\n          open\n          selected\n          isNow\n          isAfterFiveMinutes\n          isSlotAlreadyUsed\n          isDynamicallyAdded\n          __typename\n        }\n        __typename\n      }\n      slotForToday {\n        startTimeInMins\n        endTimeInMins\n        date\n        usedSlots\n        isSlotQueueSelectionEnabled\n        totalSlots\n        offlineSlots\n        onlineSlots\n        usedOfflineSlots\n        usedOnlineSlots\n        availableSlots\n        blockedSlots {\n          requestedSlots\n          appointmentDate\n          appointmentTimeInMins\n          slotQueue\n          blockedSlotUuid\n          uuid\n          __typename\n        }\n        slotDuringHourList {\n          slotStartTime\n          slotEndTime\n          label\n          queue\n          open\n          selected\n          isNow\n          isAfterFiveMinutes\n          isSlotAlreadyUsed\n          isDynamicallyAdded\n          __typename\n        }\n        __typename\n      }\n      slotForTomorrow {\n        startTimeInMins\n        endTimeInMins\n        date\n        usedSlots\n        isSlotQueueSelectionEnabled\n        totalSlots\n        offlineSlots\n        onlineSlots\n        usedOfflineSlots\n        usedOnlineSlots\n        availableSlots\n        blockedSlots {\n          requestedSlots\n          appointmentDate\n          appointmentTimeInMins\n          slotQueue\n          blockedSlotUuid\n          uuid\n          __typename\n        }\n        slotDuringHourList {\n          slotStartTime\n          slotEndTime\n          label\n          queue\n          open\n          selected\n          isNow\n          isAfterFiveMinutes\n          isSlotAlreadyUsed\n          isDynamicallyAdded\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n}&quot;}</stringProp>
