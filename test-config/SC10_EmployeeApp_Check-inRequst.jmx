      __typename
    }
    appointment {
      date
      startTimeInMins
      endTimeInMins
      slotQueue
      isDynamicallyAdded
      __typename
    }
    registrationChecks {
      identity
      forms
      insurance
      medicare
      patientDetails
      contactDetails
      insuranceDetails
      medicare
      insuranceHolder
      financialResponsibility
      condOfServAndConsentToTreat
      patientFinancialResponsibility
      authToReleaseInfo
      ackOfRightsAndPrivacy
      medicalRecordDiscloser
      childProxyForm
      childProxyConsent
      __typename
    }
    iAmHere
    isVisitConfirmed
    notes {
      comments
      timeStamp
      notesBy
      hasNew
      email
      __typename
    }
    centerInfo {
      centerId
      facilityName
      providerName
      orgName
      __typename
    }
    reason
    isNewVisit
    preVisitId
    anyOtherReason
    visitTypePhysical
    dateOfInjury
    visitAudit {
      timeStamp
      actionTakenBy
      field
      fieldAudit {
        fieldName
        oldValue
        newValue
        __typename
      }
      __typename
    }
    delayTime {
      delayedByInMinutes
      actualDelayTime
      inExamDelay
      __typename
    }
    isNewPatientApp
    priority
    idMismatchInfo
    insuranceMismatchInfo
    currentStatusCode
    attendedBy
    isAdhocVisit
    isNurseVisit
    isTelemedVisit
    currentSubStatusCode
    consentToSMSNotification
    visitType
    isOccMedVisit
    employeeServiceType
    inExamAttendedBy {
      _id
      attendedBy
      userJoined
      isUserEverJoined
      isVideoLinkShared
      isClaimed
      providerJoined
      isProviderEverJoined
      isUserEncounteredError
      userSessionAudit
      isProviderEncounteredError
      notes {
        comments
        timeStamp
        notesBy
        email
        __typename
      }
      __typename
    }
    isFollowUpPhysicalVisit
