              <stringProp name="script">// Path to your Node.js script
def scriptPath = &apos;C:\\Users\\ArunaJyothi.CTR\\Downloads\\WellStreet\\WellStreet\\encrypt_script.js&apos;
 
// Action and Encrypted Text  encrypt  decrypt
def action = &apos;encrypt&apos;


//def P_UUID = vars.get(&quot;P_UUID&quot;)


def encryptedText = vars.get(&quot;C_visitId&quot;)
 
//def safeText = encryptedText.inspect()
 
// Prepare command
def command = [&quot;node&quot;, scriptPath, action, encryptedText]
 
// Execute the Node.js script
def process = new ProcessBuilder(command)
    .redirectErrorStream(true)
    .start()
 
// Wait for the process to complete
process.waitFor()
 
// Get the output
def output = process.in.text.trim()
 
// Print to console (JMeter logs)
log.info(&quot;Decrypted value: &quot; + output)
 
// Store in JMeter variable if needed
vars.put(&quot;decryptedvisitId&quot;, output)</stringProp>
