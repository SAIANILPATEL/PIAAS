nsurance\n      medicare\n      patientDetails\n      contactDetails\n      insuranceDetails\n      medicare\n      insuranceHolder\n      financialResponsibility\n      condOfServAndConsentToTreat\n      patientFinancialResponsibility\n      authToReleaseInfo\n      ackOfRightsAndPrivacy\n      medicalRecordDiscloser\n      childProxyForm\n      childProxyConsent\n      __typename\n    }\n    iAmHere\n    isVisitConfirmed\n    notes {\n      comments\n      timeStamp\n      notesBy\n      hasNew\n      email\n      __typename\n    }\n    centerInfo {\n      centerId\n      facilityName\n      providerName\n      orgName\n      __typename\n    }\n    reason\n    isNewVisit\n    preVisitId\n    anyOtherReason\n    visitTypePhysical\n    dateOfInjury\n    visitAudit {\n      timeStamp\n      actionTakenBy\n      field\n      fieldAudit {\n        fieldName\n        oldValue\n        newValue\n        __typename\n      }\n      __typename\n    }\n    delayTime {\n      delayedByInMinutes\n      actualDelayTime\n      inExamDelay\n      __typename\n    }\n    isNewPatientApp\n    priority\n    idMismatchInfo\n    insuranceMismatchInfo\n    currentStatusCode\n    attendedBy\n    isAdhocVisit\n    isNurseVisit\n    isTelemedVisit\n    currentSubStatusCode\n    consentToSMSNotification\n    visitType\n    isOccMedVisit\n    employeeServiceType\n    inExamAttendedBy {\n      _id\n      attendedBy\n      userJoined\n      isUserEverJoined\n      isVideoLinkShared\n      isClaimed\n      providerJoined\n      isProviderEverJoined\n      isUserEncounteredError\n      userSessionAudit\n      isProviderEncounteredError\n      notes {\n        comments\n        timeStamp\n        notesBy\n        email\n        __typename\n      }\n      __typename\n    }\n    isFollowUpPhysicalVisit\n    isInClinicProviderVisitRequired\n    isFollowUpTelemedVisitCovidOnly\n    isFollowUpTelemedVisit\n    consent {\n      consentToTreat\n      consentToFinanicalResposibity\n      consentToReleaseInformation\n      consentToChildProxy\n      consentToPrivacy\n      consentToSelfPay\n      consentToTeleMedicine\n      __typename\n    }\n    rcmPayment {\n      patientResponsibility {\n        isAmountToBeCollected\n        isTypeCopay\n        isTypeCoInsurance\n        isTypeDeductible\n        isTypeSelfPay\n        paymentType {\n          coPay {\n            isAmountToBeCollected\n            amount\n            collected\n            isCollected\n            __typename\n          }\n          deductible {\n            isAmountToBeCollected\n            amount\n            collected\n            isCollected\n            __typename\n          }\n          selfPay {\n            isAmountToBeCollected\n            amount\n            collected\n            isCollected\n            __typename\n          }\n          __typename\n        }\n        amount\n        comments\n        isTotalAmountCollected\n        collectedAmount\n        commentsAtCollection\n        isResponsibilityPaidPartially\n        reasonForNotPaying\n        otherReasonCommentForPatientResponsibility\n        __typename\n      }\n      patientOutstanding {\n        isOutstandingBalance\n        amount\n        comments\n        isTotalOutstandingCollected\n        collectedAmount\n        commentsAtCollection\n        isOutstandingPaidPartially\n        reasonForNotPaying\n        otherReasonCommentForOutstanding\n        __typename\n      }\n      timeStamp\n      billedBy\n      collectedBy\n      responsibilityDeniedReason\n      responsibilityDeniedOtherReason\n      isCOFCardDetailForEMREnabled\n      eMRCardDetailReason\n      eMRCardDetailOtherReason\n      __typename\n    }\n    __typename\n  }\n}&quot;}</stringProp>
