lection\n        isOutstandingPaidPartially\n        reasonForNotPaying\n        otherReasonCommentForOutstanding\n        __typename\n      }\n      timeStamp\n      billedBy\n      collectedBy\n      responsibilityDeniedReason\n      responsibilityDeniedOtherReason\n      isCOFCardDetailForEMREnabled\n      eMRCardDetailReason\n      eMRCardDetailOtherReason\n      __typename\n    }\n    birdEyeAudit {\n      checkinId\n      customerId\n      error\n      __typename\n    }\n    mrn\n    centerInfo {\n      centerId\n      facilityName\n      providerName\n      orgName\n      address {\n        address1\n        city\n        state\n        zipcode\n        coordinates\n        __typename\n      }\n      __typename\n    }\n    email\n    phoneNumber\n    createdDateTime\n    updatedDateTime\n    appointment {\n      date\n      startTimeInMins\n      endTimeInMins\n      slotQueue\n      reasonForReschedule\n      isDynamicallyAdded\n      __typename\n    }\n    reason\n    anyOtherReason\n    visitTypeOther\n    visitTypePhysical\n    dateOfInjury\n    currentStatusCode\n    currentSubStatusCode\n    consentToSMSNotification\n    isNewVisit\n    isFollowUpVisit\n    isFollowUpCreated\n    followup {\n      visitTimeStamp\n      visitClinic\n      visitCreatedBy\n      visitCode\n      __typename\n    }\n    attendedBy\n    patientInfo {\n      patientId\n      firstName\n      lastName\n      middleName\n      preferredName\n      dateOfBirth\n      sex\n      language\n      isMarried\n      ethnicity\n      race\n      preferredPharmacy {\n        name\n        address\n        __typename\n      }\n      __typename\n    }\n    photoIdUri {\n      front {\n        name\n        uri\n        previewBase64\n        __typename\n      }\n      back {\n        name\n        uri\n        previewBase64\n        __typename\n      }\n      __typename\n    }\n    contactDetails {\n      phoneNumber\n      email\n      address1\n      address2\n      city\n      state\n  