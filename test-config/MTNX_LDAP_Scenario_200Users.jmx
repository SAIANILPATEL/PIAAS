            <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="C_inventoryId3" enabled="false">
              <stringProp name="RegexExtractor.useHeaders">false</stringProp>
              <stringProp name="RegexExtractor.refname">C_inventoryId3</stringProp>
              <stringProp name="RegexExtractor.regex">&quot;inventoryId&quot;:&quot;(.*?)&quot;</stringProp>
              <stringProp name="RegexExtractor.template">$1$</stringProp>
              <stringProp name="RegexExtractor.default">Not_Found_C_inventoryId3</stringProp>
              <stringProp name="RegexExtractor.match_number">3</stringProp>
            </RegexExtractor>
            <hashTree/>
            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor" enabled="true">
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="script">StringBuffer sb1= new StringBuffer();
int i;
int count= Integer.parseInt(vars.get(&quot;C_inventoryId1_matchNr&quot;));
for(i=1;i&lt;=count;i++)
{
sb1.append(&quot;{\&quot;id\&quot;:\&quot;&quot;);
sb1.append(vars.get(&quot;C_inventoryId1_&quot;+ i));
sb1.append(&quot;\&quot;,\&quot;oilUptakeAmount\&quot;:\&quot;2\&quot;}&quot;);

if(i&lt;count)
{
	sb1.append(&quot;,&quot;);
}
}
vars.put(&quot;concString&quot;,sb1.toString());
</stringProp>
            </BeanShellPostProcessor>
            <hashTree/>
          </hashTree>
