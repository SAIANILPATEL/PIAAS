            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor" enabled="false">
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="script">vars.put(&quot;date1&quot;,&quot;${__groovy(java.time.LocalDate.now().minusMonths(1).format(&quot;yyyy-M-d&quot;),)}&quot;);
String date2=vars.get(&quot;date1&quot;);
String[] words = date2.split(&quot;-&quot;);

vars.putObject(&quot;BS_Year&quot;, words[0].toString()); 
vars.putObject(&quot;BS_Month&quot;, words[1].toString()); 
vars.putObject(&quot;BS_Date&quot;, words[2].toString()); 
//log.info(vars.get(&quot;BS_Year&quot;); 
log.info(vars.get(&quot;BS_Year&quot;));
log.info(vars.get(&quot;BS_Month&quot;));
log.info(vars.get(&quot;BS_Date&quot;));</stringProp>
            </BeanShellPreProcessor>
