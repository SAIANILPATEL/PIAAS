              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import java.text.SimpleDateFormat
import java.util.Calendar
 
// Define your input time as &quot;HH:MM&quot;
def inputTime = vars.get(&quot;C_defaultDuration&quot;)  // Example time; replace this with your actual variable if needed
 
// Convert input time (&quot;HH:MM&quot;) to minutes
def timeParts = inputTime.split(&quot;:&quot;)
def hours = Integer.parseInt(timeParts[0])
def minutes = Integer.parseInt(timeParts[1])
def totalMinutes = (hours * 60) + minutes
log.info(&quot;Total minutes for time &apos;${inputTime}&apos;: ${totalMinutes}&quot;)
 
// Get current time and add 10 minutes to it (for t1)
Calendar now = Calendar.getInstance()
now.add(Calendar.MINUTE, 20)  // Adding 10 minutes
 
// Format t1 to &quot;YYYY-MM-DDTHH:MM:SS&quot;
SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss&quot;)
def t1 = sdf.format(now.getTime())
log.info(&quot;Time t1 (current time + 10 minutes): ${t1}&quot;)
 
// Add the calculated minutes to t1 for t2
now.add(Calendar.MINUTE, totalMinutes)  // Add the calculated minutes to t1
 
// Format t2 to &quot;YYYY-MM-DDTHH:MM:SS&quot;
def t2 = sdf.format(now.getTime())
log.info(&quot;Time t2 (t1 + input time in minutes): ${t2}&quot;)
 
// Optionally, set t1 and t2 as JMeter variables (if needed)
vars.put(&quot;t1&quot;, t1)
vars.put(&quot;t2&quot;, t2)
vars.put(&quot;totalMinutes&quot;,&quot;&quot;+totalMinutes)</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
