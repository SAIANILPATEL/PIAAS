            <stringProp name="GraphQLHTTPSampler.operationName">EventEdit</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">query EventEdit($id: ID!) {
  activity(id: $id) {
    ...EventEdit
    __typename
  }
}

fragment EventEdit on Activity {
  id
  activityDate
  activityTime
  activityDurationMinutes
  activityEndTime
  activityTypeEntityId
  activityType {
    taskCategoryId
    __typename
  }
  allowDigitalBooking
  description
  dailyNews
  digitalDisplay
  locationId
  layoutId
  prevStatus
  status
  setupTime
  cleanupTime
  movable
  privateEvent
  ownerId
  ownerAccountType
  expectedGuestCount
  actualGuestCount
  contactDesc
  accountingDesc
  entertainmentOptionsDesc
  venueRequirementDesc
  specialRequirementDesc
  extendedDescription
  invitationMessage
  finalizeBy
  complimentsDescription
  comments
  printTimeDescription
  printLocationDescription
  printProviderDescription
  groupProfileGql {
    internalCode
    description
    __typename
  }
  personProfileGql {
    firstName
    lastName
    __typename
  }
  creationDTTMLocal
  locationReleased
  listParticipants
  shipId
  recurrenceType
  recurOnEvery
  recurrenceCron
  recurrenceCruiseDays
  recurrenceEndAfter
  recurrenceEndBy
  recurrencePortDaysOnly
  recurrenceSeaDaysOnly
  ticketing
  ticketingType
  imageId
  deleted
  who
  __typename
}
</stringProp>
