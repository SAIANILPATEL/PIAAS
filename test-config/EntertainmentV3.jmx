            <stringProp name="GraphQLHTTPSampler.query">query TaskTypeStore($hierarchyId: String!, $search: String, $page: Int, $size: Int, $sort: String) {
  pageableTaskTypes(
    hierarchyId: $hierarchyId
    search: $search
    page: $page
    size: $size
    sort: $sort
  ) {
    totalElements
    last
    content {
      ...TaskTypeStoreItem
      __typename
    }
    __typename
  }
}

fragment TaskTypeStoreItem on TaskType {
  entityId
  taskCategoryId
  code
  description
  deleted
  enabled
  defaultDuration
  defaultSetupTime
  defaultCleanUpTime
  listParticipants
  venueRequirements
  entertainmentOptions
  specialInstructions
  validateAtSecurity
  gateDirection
  gateMode
  gateType
  accountTypes
  actionType
  operationalPositionEntityIds
  alertDisplayMessage
  training
  drill
  allowAbsenceRequest
  requireAbsenceReason
  allowOverlap
  __typename
}
</stringProp>
