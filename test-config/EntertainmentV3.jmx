  itemsTicketingAvailable
  deleted
  who
  __typename
}

fragment EventOverviewTimelineLocation on Location {
  id
  translations
  openingTimes {
    fromTime
    toTime
    __typename
  }
  locationOwnerPosition
  locationType
  bookingGroup
  __typename
}
