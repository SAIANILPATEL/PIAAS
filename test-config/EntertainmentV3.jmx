            <stringProp name="GraphQLHTTPSampler.query">query PositionsStore($hierarchyId: String, $search: String, $page: Int, $size: Int, $sort: String, $withDepartment: Boolean = false) {
  pageableOperationalPositions(
    hierarchyId: $hierarchyId
    search: $search
    page: $page
    size: $size
    sort: $sort
  ) {
    totalElements
    number
    totalPages
    content {
      ...OperationalPositionStoreItem
      __typename
    }
    __typename
  }
}

fragment OperationalPositionStoreItem on OperationalPosition {
  id
  description
  departmentId
  department @include(if: $withDepartment) {
    id
    code
    description
    __typename
  }
  entityId
  deleted
  code
  enabled
  __typename
}
</stringProp>
