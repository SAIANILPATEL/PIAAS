            <stringProp name="GraphQLHTTPSampler.query">query PageableActivityStaffing($hierarchyId: String!, $search: String, $page: Int, $size: Int, $sort: String) {
  pageableActivityStaffing(
    hierarchyId: $hierarchyId
    search: $search
    page: $page
    size: $size
    sort: $sort
  ) {
    content {
      id
      activityId
      approvedBy
      approvedByGql {
        ...EventEditorApprovedByStaff
        __typename
      }
      approvedDateTime
      deleted
      maximum
      minimum
      operationPositionEntityId
      operationPositionGql(hierarchyId: $hierarchyId) {
        ...EventEditorOperationPositionStaff
        __typename
      }
      requiresApproval
      status
      __typename
    }
    size
    totalElements
    totalPages
    __typename
  }
}

fragment EventEditorApprovedByStaff on User {
  id
  firstName
  lastName
  __typename
}

fragment EventEditorOperationPositionStaff on OperationalPosition {
  entityId
  code
  description
  __typename
}
