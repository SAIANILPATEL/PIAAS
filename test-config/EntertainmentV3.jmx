            <stringProp name="GraphQLHTTPSampler.query">query GuestSearchSameCabinList($reservationId: String!, $search: String, $page: Int, $size: Int, $sort: String, $hierarchyId: String, $withServiceItemRequestsInfo: Boolean = false, $withPersonSearchInfo: Boolean = false, $withLoyaltyProgramValueInfo: Boolean = false) {
  pageableReservationsSameCabin(
    reservationId: $reservationId
