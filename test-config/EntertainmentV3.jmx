            <stringProp name="GraphQLHTTPSampler.query">query ActivityById($id: ID!) {
  activity(id: $id) {
    ...ActivityOverview
    __typename
  }
}

fragment ActivityOverview on Activity {
  id
  status
  event
  activityType {
    description
    listParticipants
    filters
    taskCategory {
      id
      entityId
      code
      translations
      __typename
    }
    training
    __typename
  }
  activityTypeEntityId
  activityDate
  activityEndTime
  activityStartTime
  activityTime
  activityDuration
  validateAtSecurity
  gateDirection
  gateMode
  gateType
  locationId
  description
  location {
    id
    translations
    __typename
  }
  listParticipants
  accountTypes
  allowAbsenceRequest
  participantRsqlSearch
  participantSearchByExclusion
  recurrenceCron
  recurrenceCruiseDays
  recurrenceEndAfter
  recurrenceEndBy
  recurrenceType
  recurOnEvery
  recurrencePortDaysOnly
  recurrenceSeaDaysOnly
  requireAbsenceReason
  participantFiltersConfig {
    key
    type
    value
    __typename
  }
  shipId
  qualificationId
  __typename
}
</stringProp>
