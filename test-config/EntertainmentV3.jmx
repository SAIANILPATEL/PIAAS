fragment ActivityLandingCalendarEvent on Activity {
  id
  status
  description
  location {
    id
    translations
    locationOwnerPosition
    __typename
  }
  activityType {
    entityId
    colorCode
    __typename
  }
  activityTime
  activityStartTime
  activityEndTime
  allDay
  recurrenceCron
  recurrenceType
  shipId
  who
  __typename
}
</stringProp>
