str1 = vars.get(&quot;t2&quot;);
log.info(&quot;+++++++++++++sid+++&quot;+str);
str = str.replace(&apos;:&apos;,&apos;%3A&apos;);
str1 = str1.replace(&apos;:&apos;,&apos;%3A&apos;);
vars.put(&quot;t1_%3A&quot;,str);
vars.put(&quot;t2_%3A&quot;,str1);</stringProp>
