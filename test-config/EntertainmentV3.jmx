                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;CurrentUserTaskCategoriesStore&quot;,&quot;variables&quot;:{&quot;page&quot;:0,&quot;search&quot;:&quot;taskCategory.entityId%3D%3D%22All%22%20and%20taskCategory.enabled%3D%3Dtrue&quot;,&quot;sort&quot;:&quot;taskCategory.description&quot;},&quot;query&quot;:&quot;query CurrentUserTaskCategoriesStore($search: String, $page: Int, $size: Int, $sort: String) {\n  pageableCurrentUserTaskCategories(\n    search: $search\n    page: $page\n    size: $size\n    sort: $sort\n  ) {\n    totalElements\n    last\n    content {\n      ...CurrentUserTaskCategory\n      __typename\n    }\n    __typename\n  }\n}\n\nfragment CurrentUserTaskCategory on UserTaskCategory {\n  taskCategory {\n    ...LookupValueStore\n    __typename\n  }\n  __typename\n}\n\nfragment LookupValueStore on LookupValue {\n  entityId\n  translations\n  code\n  externalDescription\n  enabled\n  deleted\n  __typename\n}&quot;}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
