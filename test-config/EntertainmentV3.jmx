            <stringProp name="GraphQLHTTPSampler.operationName">CurrentUserTaskCategoriesStore</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">query CurrentUserTaskCategoriesStore($search: String, $page: Int, $size: Int, $sort: String) {
  pageableCurrentUserTaskCategories(
    search: $search
    page: $page
    size: $size
    sort: $sort
  ) {
    totalElements
    last
    content {
      ...CurrentUserTaskCategory
      __typename
    }
    __typename
  }
}

fragment CurrentUserTaskCategory on UserTaskCategory {
  taskCategory {
    ...LookupValueStore
    __typename
  }
  __typename
}

fragment LookupValueStore on LookupValue {
  entityId
  translations
  code
  externalDescription
  enabled
  deleted
  __typename
}
</stringProp>
