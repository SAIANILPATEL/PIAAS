      eventApprovalRequired
      locationOwnerPosition
      bookingGroup
      openingTimes {
        toTime
        fromTime
        __typename
      }
      __typename
    }
    __typename
  }
}

fragment LocationStoreLayout on LocationAvailableLayout {
  id
  layoutName
  __typename
}
