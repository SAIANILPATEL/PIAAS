            <stringProp name="GraphQLHTTPSampler.query">query AshoreLogMovement($gateMovementsSearch: String, $search: String, $page: Int, $size: Int, $sort: String) {
  pageablePersonReservations(
    search: $search
    page: $page
    size: $size
    sort: $sort
  ) {
    totalElements
    content {
      id
      accountType
      cabin {
        code
        __typename
      }
      profile {
        id
        firstName
        lastName
        visitorId
        __typename
      }
      gateMovementsGql(search: $gateMovementsSearch, sort: &quot;creationDTTM,desc&quot;) {
        ...ReservationsLogGateMovement
        __typename
      }
      __typename
    }
    __typename
  }
}

fragment ReservationsLogGateMovement on GateMovementDto {
  id
  when
  locationName
  captureMethod
  who
  userGql {
    ...UserProfileData
    __typename
  }
  workstation
  __typename
}

fragment UserProfileData on User {
  id
  userProfile {
    id
    firstName
    lastName
    __typename
  }
  __typename
}
