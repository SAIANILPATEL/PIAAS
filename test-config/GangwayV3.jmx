            <stringProp name="GraphQLHTTPSampler.operationName">TravelWithMovement</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">query TravelWithMovement($reservationId: ID!, $search: String, $sort: String, $withTravelWith: Boolean = false, $withVisitorId: Boolean = false, $withSafetyNumber: Boolean = false) {
  pageableRelatedPersons(
    reservationId: $reservationId
    search: $search
    sort: $sort
  ) {
    content {
      ...TravelWithMovementPerson
      __typename
    }
    __typename
  }
}

fragment TravelWithMovementPerson on PersonSearch {
  accountType
  reservationId
  profilePicId
  onboard
  reservationStatus
  firstName
  lastName
  cabin {
    code
    __typename
  }
  guardianInformation {
    guarded {
      reservationId
      __typename
    }
    guardian {
      reservationId
      __typename
    }
    __typename
  }
  travelWith @include(if: $withTravelWith)
  visitorDetails @include(if: $withVisitorId) {
    visitorId
    __typename
  }
  crewDetails @include(if: $withSafetyNumber) {
    safety {
      planNumber
      __typename
    }
    __typename
  }
  __typename
}
</stringProp>
