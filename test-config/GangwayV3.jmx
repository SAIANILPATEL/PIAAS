            <stringProp name="GraphQLHTTPSampler.query">query GangwayPersonReservation($id: ID!, $withAlias: Boolean = false, $withFirstNameOther: Boolean = false, $withLastNameOther: Boolean = false, $withMiddleName: Boolean = false, $withSalutation: Boolean = false, $withTitle: Boolean = false, $withEyeColor: Boolean = false, $withHairColor: Boolean = false, $withHeightImperial: Boolean = false, $withHeightMetric: Boolean = false, $withWeightImperial: Boolean = false, $withWeightMetric: Boolean = false, $withActiveFrom: Boolean = false, $withActiveTo: Boolean = false, $withSafetyNumber: Boolean = false, $withBookingNumber: Boolean = false) {
  personReservation(id: $id) {
    ...gangwayPersonFragment
    __typename
  }
}

fragment gangwayPersonFragment on PersonReservation {
  reservationStatus
  id
  onboard
  accountType
  bookingNumber @include(if: $withBookingNumber)
  travelWith
  cabinId
  cabin {
    id
    code
    __typename
  }
  profile {
    nationality {
      id
      flagIconId
      translations
      __typename
    }
    id
    preferredLanguage
    firstName
    lastName
    dateOfBirth
    profilePicId
    genderValue {
      id
      translations
      __typename
    }
    alias @include(if: $withAlias)
    firstNameOther @include(if: $withFirstNameOther)
    lastNameOther @include(if: $withLastNameOther)
    middleName @include(if: $withMiddleName)
    salutation @include(if: $withSalutation) {
      id
      translations
      __typename
    }
    titleValue @include(if: $withTitle) {
      id
      translations
      __typename
    }
    eyeColorValue @include(if: $withEyeColor) {
      id
      translations
      __typename
    }
    hairColorValue @include(if: $withHairColor) {
      id
      translations
      __typename
    }
    heightImperial @include(if: $withHeightImperial)
    heightMetric @include(if: $withHeightMetric)
    visitorId
    weightMetric @include(if: $withWeightMetric)
    weightImperial @include(if: $withWeightImperial)
    __typename
  }
  scheduledEmbarkationDate @include(if: $withActiveFrom)
  scheduledDisembarkationDate @include(if: $withActiveTo)
  safetyDetails @include(if: $withSafetyNumber) {
    id
    safetyPlan {
      id
      safetyNumber
      __typename
    }
    __typename
  }
  __typename
}
</stringProp>
