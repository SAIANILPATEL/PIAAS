                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;Settings&quot;,&quot;variables&quot;:{&quot;isOnlyValue&quot;:true,&quot;environmentId&quot;:&quot;${ShipEnvironmentId}&quot;,&quot;search&quot;:&quot;code%3Din%3D%28GSEC-MV-LOOKUP-PASS%2CGSEC-MV-LOOKUP-VSTR%2CGSEC-MV-LOOKUP-CREW%29&quot;},&quot;query&quot;:&quot;query Settings($size: Int, $search: String, $page: Int, $environmentId: String!, $isOnlyValue: Boolean = false) {\n  pageableSetting(\n    environmentId: $environmentId\n    size: $size\n    search: $search\n    page: $page\n  ) {\n    content {\n      code\n      value\n      multipleValues\n      valueType @skip(if: $isOnlyValue)\n      defaultValue @skip(if: $isOnlyValue)\n      enabled\n      __typename\n    }\n    __typename\n  }\n}&quot;}</stringProp>
