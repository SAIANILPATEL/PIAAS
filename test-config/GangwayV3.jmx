            <stringProp name="GraphQLHTTPSampler.operationName">LocationsInfiniteSelect</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">query LocationsInfiniteSelect($shipId: String!, $locationType: String, $search: String, $page: Int, $size: Int, $sort: String) {
  pageableLocations(
    shipId: $shipId
    locationType: $locationType
    search: $search
    page: $page
    size: $size
    sort: $sort
  ) {
    totalElements
    number
    totalPages
    content {
      id
      code
      deleted
      enabled
      translations
      availableLayouts {
        ...LocationStoreLayout
        __typename
      }
      privateEvent
      eventApprovalRequired
      locationOwnerPosition
      bookingGroup
      openingTimes {
        toTime
        fromTime
        __typename
      }
      __typename
    }
    __typename
  }
}

fragment LocationStoreLayout on LocationAvailableLayout {
  id
  layoutName
  __typename
}
</stringProp>
