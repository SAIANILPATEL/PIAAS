            <stringProp name="GraphQLHTTPSampler.query">query CrewSummaryInit($reservationId: ID!, $hierarchyId: String!, $cabinId: ID!, $privilegeSearch: String, $safetyPlanSearch: String) {
  cabin(id: $cabinId) {
    ...CrewLinkedCabin
    __typename
  }
  pageableClassificationsV2(search: $privilegeSearch, hierarchyId: $hierarchyId) {
    content {
      ...CrewSummaryPrivilege
      __typename
    }
    __typename
  }
  pageableSafetyPlanAssignment(
    shipId: $hierarchyId
    search: $safetyPlanSearch
    page: 0
    size: 1
  ) {
    content {
      safetyPlan {
        ...CrewSafetyCardItem
        __typename
      }
      __typename
    }
    __typename
  }
  personSearch(id: $reservationId) {
    ...CrewOperationsCard
    __typename
  }
}

fragment CrewLinkedCabin on Cabin {
  linkedCabinsValue {
    code
    __typename
  }
  __typename
}

fragment CrewSummaryPrivilege on ClassificationV2 {
  translations
  __typename
}

fragment CrewSafetyCardItem on SafetyPlan {
  id
  safetyNumber
  rank
  division {
    id
    description
    __typename
  }
  position {
    id
    description
    __typename
  }
  inPortManning {
    group {
      id
      description
      __typename
    }
    details {
      ...InPortManningDetail
      __typename
    }
    __typename
  }
  emergencyPlan {
    emergencyType {
      description
      __typename
    }
    details {
      id
      emergencyTeamSafetyGroup {
        id
        description
        __typename
      }
      __typename
    }
    __typename
  }
  __typename
}

fragment InPortManningDetail on InPortManningDetail {
  id
  step
  musterStationLocation {
    id
    translations
    __typename
  }
  safetyInstruction {
    id
    comment
    description
    __typename
  }
  __typename
}

fragment CrewOperationsCard on PersonSearch {
  crewDetails {
    operations {
      login
      crewId
      operationalPosition {
        description
        shoreReportingToPositionGql {
          description
          __typename
        }
        shipReportingToPositionGql {
          description
          __typename
        }
        __typename
      }
      operationalDivision {
        description
        __typename
      }
      operationalDepartment {
        description
        __typename
      }
      operationalSubDepartment {
        description
        __typename
      }
      priorOperationalPositions {
        description
        __typename
      }
      trainings {
        name
        __typename
      }
      certificates {
        name
        __typename
      }
      recognitions
      disciplines
      __typename
    }
    __typename
  }
  userCredentialsGql {
    userSecurity {
      lastLogonDateTime
      __typename
    }
    __typename
  }
  __typename
}
</stringProp>
