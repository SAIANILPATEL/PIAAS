            <stringProp name="GraphQLHTTPSampler.query">query CrewShortList($search: String, $page: Int, $size: Int, $sort: String) {
  pageablePersonSearches(
    search: $search
    page: $page
    size: $size
    sort: $sort
    includeAllAccounts: true
  ) {
    number
    totalPages
    first
    last
    totalElements
    content {
      ...GuestShortList
      __typename
    }
    __typename
  }
}

fragment GuestShortList on PersonSearch {
  reservationId
  firstName
  lastName
  profilePicId
  reservationStatus
  onboard
  accountType
  cabin {
    code
    __typename
  }
  embarkation {
    displayDate
    __typename
  }
  disembarkation {
    displayDate
    __typename
  }
  __typename
}
</stringProp>
