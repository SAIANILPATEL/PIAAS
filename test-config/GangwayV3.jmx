fragment ShedulerVoyageDay on VoyageDay {
  id
  code
  seaDay
  allAboardTime
  itineraryVoyageId
  dressCodeCrew {
    code
    translations
    __typename
  }
  dressCodePassenger {
    code
    translations
    __typename
  }
  portServiceDesc {
    code
    translations
    __typename
  }
  arrivalTime
  goAshoreTime
  departureTime
  voyageDayDate
  when
  ageGroupTemplate {
    code
    translations
    __typename
  }
  countryId
  portId
  portEntity {
    ...ShedulerVoyageDayPort
    __typename
  }
  taxTemplateEntity {
    code
    taxRegionObject {
      code
      translations
      __typename
    }
    __typename
  }
  countryGql {
    id
    code
    iso3
    translations
    __typename
  }
  itineraryVoyageGql {
    id
    startDate
    endDate
    externalId
    translations
    __typename
  }
  __typename
}

fragment ShedulerVoyageDayPort on Port {
  id
  code
  country {
    id
    code
    iso3
    translations
    __typename
  }
  officialDescription
  tender
  translations
  contactAgencyId
  usStateId
  __typename
}
</stringProp>
