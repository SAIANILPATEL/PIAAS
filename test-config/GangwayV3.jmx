                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;CrewSummaryInit&quot;,&quot;variables&quot;:{&quot;reservationId&quot;:&quot;${C_reservationId}&quot;,&quot;cabinId&quot;:&quot;${C_resCabinId}&quot;,&quot;privilegeSearch&quot;:&quot;operationalPositionLinks.positionEntityId%3D%3D${C_posEntityId}%20and%20enabled%3D%3Dtrue%20and%20isDeleted%3D%3Dfalse&quot;,&quot;safetyPlanSearch&quot;:&quot;crewReservationId%3D%3D${C_reservationId}%20and%20status%3D%3DACTIVE&quot;,&quot;hierarchyId&quot;:&quot;${C_shipId}&quot;},&quot;query&quot;:&quot;query CrewSummaryInit($reservationId: ID!, $hierarchyId: String!, $cabinId: ID!, $privilegeSearch: String, $safetyPlanSearch: String) {\n  cabin(id: $cabinId) {\n    ...CrewLinkedCabin\n    __typename\n  }\n  pageableClassificationsV2(search: $privilegeSearch, hierarchyId: $hierarchyId) {\n    content {\n      ...CrewSummaryPrivilege\n      __typename\n    }\n    __typename\n  }\n  pageableSafetyPlanAssignment(\n    shipId: $hierarchyId\n    search: $safetyPlanSearch\n    page: 0\n    size: 1\n  ) {\n    content {\n      safetyPlan {\n        ...CrewSafetyCardItem\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n  personSearch(id: $reservationId) {\n    ...CrewOperationsCard\n    __typename\n  }\n}\n\nfragment CrewLinkedCabin on Cabin {\n  linkedCabinsValue {\n    code\n    __typename\n  }\n  __typename\n}\n\nfragment CrewSummaryPrivilege on ClassificationV2 {\n  translations\n  __typename\n}\n\nfragment CrewSafetyCardItem on SafetyPlan {\n  id\n  safetyNumber\n  rank\n  division {\n    id\n    description\n    __typename\n  }\n  position {\n    id\n    description\n    __typename\n  }\n  inPortManning {\n    group {\n      id\n      description\n      __typename\n    }\n    details {\n      ...InPortManningDetail\n      __typename\n    }\n    __typename\n  }\n  emergencyPlan {\n    emergencyType {\n      description\n      __typename\n    }\n    details {\n      id\n      emergencyTeamSafetyGroup {\n        id\n        description\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n  __typename\n}\n\nfragment InPortManningDetail on InPortManningDetail {\n  id\n  step\n  musterStationLocation {\n    id\n    translations\n    __typename\n  }\n  safetyInstruction {\n    id\n    comment\n    description\n    __typename\n  }\n  __typename\n}\n\nfragment CrewOperationsCard on PersonSearch {\n  crewDetails {\n    operations {\n      login\n      crewId\n      operationalPosition {\n        description\n        shoreReportingToPositionGql {\n          description\n          __typename\n        }\n        shipReportingToPositionGql {\n          description\n          __typename\n        }\n        __typename\n      }\n      operationalDivision {\n        description\n        __typename\n      }\n      operationalDepartment {\n        description\n        __typename\n      }\n      operationalSubDepartment {\n        description\n        __typename\n      }\n      priorOperationalPositions {\n        description\n        __typename\n      }\n      trainings {\n        name\n        __typename\n      }\n      certificates {\n        name\n        __typename\n      }\n      recognitions\n      disciplines\n      __typename\n    }\n    __typename\n  }\n  userCredentialsGql {\n    userSecurity {\n      lastLogonDateTime\n      __typename\n    }\n    __typename\n  }\n  __typename\n}&quot;}</stringProp>
