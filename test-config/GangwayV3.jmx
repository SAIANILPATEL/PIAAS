            <stringProp name="GraphQLHTTPSampler.query">query GangwayGate($id: ID!) {
  gate(id: $id) {
    ...GangwayGateItem
    __typename
  }
}

fragment GangwayGateItem on GateDto {
  id
  activityScanInOutToComplete
  changeOnboardStatus
  gateDirection
  gateMode
  gateType
  locationId
  shipId
  location {
    id
    translations
    totalCapacity
    __typename
  }
  tenderCapacity
  tenderOperation
  activityId
  activityGql {
    ...GangwayGateActivityItem
    __typename
  }
  __typename
}

fragment GangwayGateActivityItem on Activity {
  id
  event
  description
  activityDate
  activityStartTime
  activityTime
  shipId
  status
  activityType {
    training
    __typename
  }
  accountTypes
  qualificationId
  qualificationGql {
    description
    __typename
  }
  requireAbsenceReason
  allowAbsenceRequest
  ticketing
  itemsTicketingAvailable
  __typename
}
</stringProp>
