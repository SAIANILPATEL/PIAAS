            <stringProp name="GraphQLHTTPSampler.query">query DayEventsAndActivities($accountType: String, $shipId: String, $startDate: String, $endDate: String, $searchActivities: String, $page: Int, $size: Int, $sort: String = &quot;activityTime,asc&quot;) {
  dayEvents(
    shipId: $shipId
    accountType: $accountType
    startDate: $startDate
    endDate: $endDate
  ) {
    ...LandingDayEvent
    __typename
  }
  activities: activities(
    search: $searchActivities
    page: $page
    size: $size
    sort: $sort
  ) {
    id
    activityDate
    activityTime
    description
    __typename
  }
}

fragment LandingDayEvent on DayEvent {
  embarking
  disembarking
  dayDate
  voyages {
    embarking
    disembarking
    voyageDayId
    __typename
  }
  __typename
}
</stringProp>
