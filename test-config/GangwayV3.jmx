            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument" enabled="true">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;GangwayPersonReservation&quot;,&quot;variables&quot;:{&quot;withAlias&quot;:false,&quot;withFirstNameOther&quot;:false,&quot;withLastNameOther&quot;:false,&quot;withMiddleName&quot;:false,&quot;withSalutation&quot;:true,&quot;withTitle&quot;:true,&quot;withEyeColor&quot;:false,&quot;withHairColor&quot;:false,&quot;withHeightImperial&quot;:false,&quot;withHeightMetric&quot;:false,&quot;withWeightImperial&quot;:false,&quot;withWeightMetric&quot;:false,&quot;withActiveFrom&quot;:false,&quot;withActiveTo&quot;:false,&quot;withSafetyNumber&quot;:false,&quot;withBookingNumber&quot;:false,&quot;id&quot;:&quot;${C_reservationID}&quot;},&quot;query&quot;:&quot;query GangwayPersonReservation($id: ID!, $withAlias: Boolean = false, $withFirstNameOther: Boolean = false, $withLastNameOther: Boolean = false, $withMiddleName: Boolean = false, $withSalutation: Boolean = false, $withTitle: Boolean = false, $withEyeColor: Boolean = false, $withHairColor: Boolean = false, $withHeightImperial: Boolean = false, $withHeightMetric: Boolean = false, $withWeightImperial: Boolean = false, $withWeightMetric: Boolean = false, $withActiveFrom: Boolean = false, $withActiveTo: Boolean = false, $withSafetyNumber: Boolean = false, $withBookingNumber: Boolean = false) {\n  personReservation(id: $id) {\n    ...gangwayPersonFragment\n    __typename\n  }\n}\n\nfragment gangwayPersonFragment on PersonReservation {\n  reservationStatus\n  id\n  onboard\n  accountType\n  bookingNumber @include(if: $withBookingNumber)\n  travelWith\n  cabinId\n  cabin {\n    id\n    code\n    __typename\n  }\n  profile {\n    nationality {\n      id\n      flagIconId\n      translations\n      __typename\n    }\n    id\n    preferredLanguage\n    firstName\n    lastName\n    dateOfBirth\n    profilePicId\n    genderValue {\n      id\n      translations\n      __typename\n    }\n    alias @include(if: $withAlias)\n    firstNameOther @include(if: $withFirstNameOther)\n    lastNameOther @include(if: $withLastNameOther)\n    middleName @include(if: $withMiddleName)\n    salutation @include(if: $withSalutation) {\n      id\n      translations\n      __typename\n    }\n    titleValue @include(if: $withTitle) {\n      id\n      translations\n      __typename\n    }\n    eyeColorValue @include(if: $withEyeColor) {\n      id\n      translations\n      __typename\n    }\n    hairColorValue @include(if: $withHairColor) {\n      id\n      translations\n      __typename\n    }\n    heightImperial @include(if: $withHeightImperial)\n    heightMetric @include(if: $withHeightMetric)\n    visitorId\n    weightMetric @include(if: $withWeightMetric)\n    weightImperial @include(if: $withWeightImperial)\n    __typename\n  }\n  scheduledEmbarkationDate @include(if: $withActiveFrom)\n  scheduledDisembarkationDate @include(if: $withActiveTo)\n  safetyDetails @include(if: $withSafetyNumber) {\n    id\n    safetyPlan {\n      id\n      safetyNumber\n      __typename\n    }\n    __typename\n  }\n  __typename\n}&quot;}</stringProp>
