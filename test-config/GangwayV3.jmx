            <stringProp name="GraphQLHTTPSampler.operationName">Settings</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">query Settings($size: Int, $search: String, $page: Int, $environmentId: String!, $isOnlyValue: Boolean = false) {
  pageableSetting(
    environmentId: $environmentId
    size: $size
    search: $search
    page: $page
  ) {
    content {
      code
      value
      multipleValues
      valueType @skip(if: $isOnlyValue)
      defaultValue @skip(if: $isOnlyValue)
