                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;GuestSearchSameBookingNumberList&quot;,&quot;variables&quot;:{&quot;withServiceItemRequestsInfo&quot;:false,&quot;withPersonSearchInfo&quot;:false,&quot;withLoyaltyProgramValueInfo&quot;:false,&quot;search&quot;:&quot;%28onboard%3Din%3D%28%22true%22%29%20and%20reservationStatus%3Din%3D%28%22CHECKED_IN%22%2C%22LEAVING_TODAY%22%2C%22EXPECT_TODAY%22%29%29&quot;,&quot;page&quot;:0,&quot;size&quot;:25,&quot;reservationId&quot;:&quot;${C_OutReservationID}&quot;},&quot;query&quot;:&quot;query GuestSearchSameBookingNumberList($reservationId: String!, $search: String, $page: Int, $size: Int, $sort: String, $hierarchyId: String, $withServiceItemRequestsInfo: Boolean = false, $withPersonSearchInfo: Boolean = false, $withLoyaltyProgramValueInfo: Boolean = false) {\n  pageableReservationsSameBookingNumber(\n    reservationId: $reservationId\n    search: $search\n    page: $page\n    size: $size\n    sort: $sort\n  ) {\n    totalElements\n    number\n    totalPages\n    content {\n      ...GuestSearch\n      __typename\n    }\n    __typename\n  }\n}\n\nfragment GuestSearch on AllReservationSearch {\n  absenceDetails {\n    absenceEndDate\n    absenceReason\n    absenceStartDate\n    absenceTourDescription\n    absenceTourId\n    currentlyAbsent\n    __typename\n  }\n  accountType\n  activeFrom\n  activeFromTime\n  activeTo\n  activeToTime\n  activityDetails {\n    participateInActivities\n    __typename\n  }\n  actualDisembarkationVoyageDayId\n  actualEmbarkationVoyageDayId\n  age\n  ageGroups {\n    category\n    group\n    __typename\n  }\n  allMemberCount\n  amountNeededToAuthorization\n  authorizationAmount {\n    totalApproveAmount\n    authorizationDetails {\n      approveAmount\n      authorizationStatus\n      authorizationType\n      creditCardType\n      creditCardTypeName\n      paymentAuthorizationId\n      paymentMethodMerchantId\n      paymentMethodTokenId\n      pspReference\n     