            <stringProp name="GraphQLHTTPSampler.operationName">GuestSearchSameBookingNumberList</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">query GuestSearchSameBookingNumberList($reservationId: String!, $search: String, $page: Int, $size: Int, $sort: String, $hierarchyId: String, $withServiceItemRequestsInfo: Boolean = false, $withPersonSearchInfo: Boolean = false, $withLoyaltyProgramValueInfo: Boolean = false) {
  pageableReservationsSameBookingNumber(
    reservationId: $reservationId
    search: $search
    page: $page
    size: $size
    sort: $sort
  ) {
    totalElements
    number
    totalPages
    content {
      ...GuestSearch
      __typename
    }
    __typename
  }
}

