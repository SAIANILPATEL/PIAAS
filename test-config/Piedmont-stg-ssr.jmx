       __typename\n          }\n          selDepId\n          flowForSlotBooking\n          bookAheadSlotConfiguration {\n            showTomorrowSlots\n            todaySlotCutoffTime\n            __typename\n          }\n          slotBuffer {\n            isEnabled\n            bufferTimeInMinutes\n            __typename\n          }\n          __typename\n        }\n        __typename\n      }\n      getAvailableSlots {\n        computedSlots {\n          slotForToday {\n            startTimeInMins\n            endTimeInMins\n            date\n            usedSlots\n            isSlotQueueSelectionEnabled\n            totalSlots\n            offlineSlots\n            onlineSlots\n            usedOfflineSlots\n            usedOnlineSlots\n            availableSlots\n            slotDuringHourList {\n              slotStartTime\n              slotEndTime\n              label\n              queue\n              open\n              selected\n              isNow\n              isAfterFiveMinutes\n              isSlotAlreadyUsed\n              __typename\n            }\n            __typename\n          }\n          slotForTomorrow {\n            startTimeInMins\n            endTimeInMins\n            date\n            usedSlots\n            isSlotQueueSelectionEnabled\n            totalSlots\n            offlineSlots\n            onlineSlots\n            usedOfflineSlots\n            usedOnlineSlots\n            availableSlots\n            slotDuringHourList {\n              slotStartTime\n              slotEndTime\n              label\n              queue\n              open\n              selected\n              isNow\n              isAfterFiveMinutes\n              isSlotAlreadyUsed\n              __typename\n            }\n            __typename\n          }\n          __typename\n        }\n        __typename\n      }\n      miles\n      __typename\n    }\n    __typename\n  }\n}&quot;}</stringProp>
