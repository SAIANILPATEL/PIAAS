            <stringProp name="GraphQLHTTPSampler.query">query center($id: String!, $coordinates: [Float!]) {
  getCenter(_id: $id, coordinates: $coordinates) {
    _id
    facilityName
    facilityType
    twilioNumber
    telemedicineCenterId
    isOcrEnabled
    miles
    slotCutOffTimeInMins
    centerStatus
    temporarilyStartDateTime
    temporarilyClosedDateTime
    comingSoonDateTime
    ezPayNotAcceptedInsurance
    configurableProperties {
      isEPICFeatureEnabled
      preVisit {
        isPreVisitEnabled
        isPreVisitEnabledForLast2hour
        isPreVisitEnabledForWalkinOnly
        __typename
      }
      checkInForm {
        hideTimeSlotInfoInPA
        __typename
      }
      selDepId
      flowForSlotBooking
      bookAheadSlotConfiguration {
        showTomorrowSlots
        todaySlotCutoffTime
        __typename
      }
      slotBuffer {
        isEnabled
        bufferTimeInMinutes
        __typename
      }
      __typename
    }
    address {
      state
      zipcode
      address1
      city
      coordinates
      landmark
      clinicPhoneNumber
      clinicFaxNumber
      __typename
    }
    locale {
      countryId
      countryName
      regionId
      regionName
      orgId
      orgName
      orgDisplayName
      divisionId
      divisionName
      orgAccronym
      __typename
    }
    insuranceCompany
    insuranceNotAcceptedForCompany
    workSchedule {
      openingTime
      closingTime
      slotDuration
      workingDaysOfWeek
      __typename
    }
    timezone
    __typename
  }
}</stringProp>
