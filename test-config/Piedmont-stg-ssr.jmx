dLabel\n          isIconHelpOnly\n          isGroupField\n          isTableViewRadioButtons\n          isGroupedHyperLink\n          multiLingualChoices {\n            label\n            value\n            __typename\n          }\n          showIf {\n            pageId: pageIndex\n            questionIndex\n            fieldIndex\n            choice\n            sectionIndex\n            condition\n            fieldType\n            value\n            __typename\n          }\n          showIfAny {\n            pageId: pageIndex\n            questionIndex\n            fieldIndex\n            choice\n            sectionIndex\n            __typename\n          }\n          showIfAll {\n            pageId: pageIndex\n            questionIndex\n            fieldIndex\n            choice\n            sectionIndex\n            condition\n            fieldType\n            value\n            __typename\n          }\n          fieldGroups {\n            isAcceptableFormID\n            modalHeadLabel\n            isBottomBoder\n            showIf {\n              pageId: pageIndex\n              questionIndex\n              fieldIndex\n              choice\n              choices\n              sectionIndex\n              condition\n              fieldType\n              value\n              __typename\n            }\n            showIfAny {\n              pageId: pageIndex\n              questionIndex\n              fieldIndex\n              choice\n              sectionIndex\n              condition\n              fieldType\n              value\n              __typename\n            }\n            field {\n              _id\n              fieldId\n              label\n              multiLingualChoices {\n                label\n                value\n                __typename\n              }\n              value\n              placeholder\n              isBackground\n              isCenterAlign\n              isGroupedLabels\n              isBackground\n              readon