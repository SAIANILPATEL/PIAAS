            <stringProp name="GraphQLHTTPSampler.operationName">getRegistrationTemplate</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">query getRegistrationTemplate($formTemplateName: String!, $lang: String!, $centerId: String!) {
  formTemplate(
    formTemplateName: $formTemplateName
    lang: $lang
    centerId: $centerId
  ) {
    _id
    formTemplateName
    version
    pages {
      pageId
      pageName
      stepName
      formIncompleteStatusMsg
      groupIndex
      groupName
      hasNoMandatoryFields
      updateFlag {
        apiModelRef
        __typename
      }
      showIf {
        pageId: pageIndex
        questionIndex
        fieldIndex
        choice
        sectionIndex
        condition
        fieldType
        value
        __typename
      }
      section {
        showInfo {
          apiModelRef
          type
          __typename
        }
        showIf {
          pageId: pageIndex
          questionIndex
          fieldIndex
          choice
          sectionIndex
          __typename
        }
        footer {
          isBackground
          message
          showIf {
            pageId: pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            __typename
          }
          __typename
        }
        header {
          isBackground
          message
          showIf {
            pageId: pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            __typename
          }
          __typename
        }
        questions {
          label
          labelHeader
          labelHtml
          hint
          help
          indicate
          helpLabel
          modalHeadLabel
          isIconHelpOnly
          isGroupField
          isTableViewRadioButtons
          isGroupedHyperLink
          multiLingualChoices {
            label
            value
            __typename
          }
          showIf {
            pageId: pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            condition
            fieldType
            value
            __typename
          }
          showIfAny {
            pageId: pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            __typename
          }
          showIfAll {
            pageId: pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            condition
            fieldType
            value
            __typename
          }
          fieldGroups {
            isAcceptableFormID
            modalHeadLabel
            isBottomBoder
            showIf {
              pageId: pageIndex
              questionIndex
              fieldIndex
              choice
              choices
              sectionIndex
              condition
              fieldType
              value
              __typename
            }
            showIfAny {
              pageId: pageIndex
              questionIndex
              fieldIndex
              choice
              sectionIndex
              condition
              fieldType
              value
              __typename
            }
            field {
              _id
              fieldId
              label
              multiLingualChoices {
                label
                value
                __typename
              }
              value
              placeholder
              isBackground
              isCenterAlign
              isGroupedLabels
              isBackground
