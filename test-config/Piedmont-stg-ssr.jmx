            <stringProp name="GraphQLHTTPSampler.query">query getAvailableSlotsV2($date: DateTime!, $centerId: String!) {
  getAvailableSlotsV2(date: $date, centerId: $centerId) {
    computedSlots {
      slotForToday {
        startTimeInMins
        date
        endTimeInMins
        slotDuringHourList {
          label
          slotStartTime
          slotEndTime
          queue
          isDynamicallyAdded
          __typename
        }
        __typename
      }
      slotForTomorrow {
        startTimeInMins
        date
        endTimeInMins
        slotDuringHourList {
          label
          slotStartTime
          slotEndTime
          queue
          isDynamicallyAdded
          __typename
        }
        __typename
      }
      __typename
    }
    __typename
  }
}</stringProp>
