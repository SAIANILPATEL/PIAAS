        questionIndex
        fieldIndex
        choice
        sectionIndex
        condition
        fieldType
        value
        __typename
      }
      section {
        showInfo {
          apiModelRef
          type
          __typename
        }
        showIf {
          pageId: pageIndex
          questionIndex
          fieldIndex
          choice
          sectionIndex
          __typename
        }
        footer {
          isBackground
          message
          showIf {
            pageId: pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            __typename
          }
          __typename
        }
        header {
          isBackground
          message
          showIf {
            pageId: pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            __typename
          }
          __typename
        }
        questions {
          label
          labelHeader
          labelHtml
          hint
          help
          indicate
          helpLabel
          modalHeadLabel
          isIconHelpOnly
          isGroupField
          isTableViewRadioButtons
          isGroupedHyperLink
          multiLingualChoices {
            label
            value
            __typename
          }
          showIf {
            pageId: pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            condition
            fieldType
            value
            __typename
          }
          showIfAny {
            pageId: pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            __typename
          }
          showIfAll {
            pageId: pageIndex
            questionIndex
            fieldIndex
            choice
            sectionIndex
            condition
            fieldType
            value
            __typename
          }
          fieldGroups {
            isAcceptableFormID
            modalHeadLabel
            isBottomBoder
            showIf {
              pageId: pageIndex
              questionIndex
              fieldIndex
              choice
              choices
              sectionIndex
              condition
              fieldType
              value
              __typename
            }
            showIfAny {
              pageId: pageIndex
              questionIndex
              fieldIndex
              choice
              sectionIndex
              condition
              fieldType
              value
              __typename
            }
            field {
              _id
              fieldId
              label
              multiLingualChoices {
                label
                value
                __typename
              }
              value
              placeholder
              isBackground
              isCenterAlign
              isGroupedLabels
              isBackground
              readonly
              isGroupField
              answerType {
                _id
                answerType
                choicesAvailable
                __typename
              }
              __typename
            }
            display {
              flex
              responsiveFlex
              __typename
            }
            value
            apiModelRef
            apiModelRefSecondary
            validation {
              required
              errorMessage
              minLength
              maxLength
              __typename
            }
            __typename
          }
          __typename
        }
        __typename
      }
      showIfAny {
        pageId: pageIndex
        questionIndex
        fieldIndex
        choice
        sectionIndex
        condition
        fieldType
        value
        __typename
      }
      showIfAll {
        pageId: pageIndex
        questionIndex
        fieldIndex
        choice
        sectionIndex
        condition
        fieldType
        value
        __typename
      }
      __typename
    }
    __typename
  }
