            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="timeStr" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import java.text.SimpleDateFormat
// Get the date-time string from the JMeter variable
def dateTimeStr = vars.get(&quot;C_StartTime&quot;)

// Define the pattern for parsing the date-time string
def pattern = &apos;MM/dd/yyyy HH:mm:ss&apos;

// Create a SimpleDateFormat object with the given pattern
def sdf = new SimpleDateFormat(pattern)

// Parse the date-time string to a Date object
def date = sdf.parse(dateTimeStr)

// Define the pattern for formatting just the time
def timePattern = &apos;HH:mm:ss&apos;

// Create another SimpleDateFormat object for the time
def timeFormat = new SimpleDateFormat(timePattern)

// Format the Date object to get just the time string
def timeStr = timeFormat.format(date)

// Store the time string in a JMeter variable
vars.put(&quot;timeStr&quot;, timeStr)

// Log the time string (optional)
log.info(&quot;Time: &quot; + timeStr)

</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="timeStrEnd" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.time.LocalTime;
import java.time.format.DateTimeFormatter;

// Get the start time from JMeter variable
String startTimeString = vars.get(&quot;timeStr&quot;);

// Parse start time from string
LocalTime startTime = LocalTime.parse(startTimeString, DateTimeFormatter.ofPattern(&quot;HH:mm:ss&quot;));

// Add 30 minutes
LocalTime endTime = startTime.plusMinutes(30);

// Format end time as string
String formattedEndTime = endTime.format(DateTimeFormatter.ofPattern(&quot;HH:mm:ss&quot;));

// Store formatted end time in JMeter variable
vars.put(&quot;timeStrEnd&quot;, formattedEndTime);

log.info(&quot;Start Time: &quot; + startTimeString);
log.info(&quot;End Time: &quot; + formattedEndTime);</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="formattedDate" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.text.SimpleDateFormat
import java.util.Date

// Get the date-time string from the JMeter variable
def dateTimeStr = vars.get(&quot;C_StartTime&quot;)

// Define the pattern for parsing the date-time string
def pattern = &apos;MM/dd/yyyy HH:mm:ss&apos;

// Create a SimpleDateFormat object with the given pattern
def sdf = new SimpleDateFormat(pattern)

// Parse the date-time string to a Date object
def date = sdf.parse(dateTimeStr)

// Define the pattern for formatting the date in the desired format
def outputPattern = &apos;EEE MMM dd yyyy&apos;

// Create another SimpleDateFormat object for the output format
def outputFormat = new SimpleDateFormat(outputPattern)

// Format the Date object to get the date string in the desired format
def formattedDateStr = outputFormat.format(date)

// Store the formatted date string in a JMeter variable
vars.put(&quot;formattedDate&quot;, formattedDateStr)

// Log the formatted date (optional)
log.info(&quot;---------------------Formatted Date: &quot; + formattedDateStr)


vars.put(&quot;loopCount1&quot;,&quot;&quot;+0)
</stringProp>
            </JSR223PreProcessor>
