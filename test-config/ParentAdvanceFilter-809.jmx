          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.time.LocalDate;
import java.time.temporal.ChronoUnit;
import java.util.concurrent.ThreadLocalRandom;

// Get today&apos;s date
LocalDate startDate = LocalDate.now();

// Calculate minimum date (current date + 2 days)
LocalDate minDate = startDate.plusDays(1);

// Calculate maximum date (current date + 4 days)
LocalDate maxDate = startDate.plusDays(14);

// Generate random date within the range minDate to maxDate (excluding weekends)
LocalDate randomDate = null;
do {
    long randomDays = ThreadLocalRandom.current().nextLong(ChronoUnit.DAYS.between(minDate, maxDate) + 1);
    randomDate = minDate.plusDays(randomDays);
} while (randomDate.getDayOfWeek().getValue() &gt;= 6); // Ensure generated date is not Saturday (6) or Sunday (7)

// Store randomDate in JMeter variables
vars.put(&quot;randomDate&quot;, randomDate.toString());
</stringProp>
