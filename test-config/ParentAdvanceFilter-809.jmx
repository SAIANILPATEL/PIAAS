                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="newDate" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import java.text.SimpleDateFormat
import java.util.Calendar

// Get the current date from the JMeter variable
def currentDateStr = vars.get(&quot;newDate&quot;).replaceAll(&apos;&quot;&apos;, &apos;&apos;)

// Define the date format
def sdf = new SimpleDateFormat(&quot;E MMM d yyyy&quot;)

// Parse the current date string to a Date object
def currentDate = sdf.parse(currentDateStr)

// Create a Calendar object and set the current date
def calendar = Calendar.getInstance()
calendar.setTime(currentDate)

// Add one day to the date
calendar.add(Calendar.DAY_OF_MONTH, 1)

// Format the new date back to the desired string format
def newDateStr = sdf.format(calendar.getTime())

// Store the new date in a JMeter variable
vars.put(&quot;newDate&quot;, newDateStr)

// Log the new date (optional)
log.info(&quot;New Date: &quot; + newDateStr)


def x = vars.get(&quot;loopCount&quot;) as int
x += 1
vars.put(&apos;loopCount&apos;, x.toString())

// Parse the start and end date variables from JMeter
def startDateStr = vars.get(&quot;C_StartTime&quot;)
def endDateStr = vars.get(&quot;C_EndTime&quot;)


if (!startDateStr.equals(&quot;C_StartTime_NF&quot;)) {
	// Parse the date strings into Date objects
	def sdf1 = new SimpleDateFormat(&quot;MM/dd/yyyy HH:mm:ss&quot;)
	def startDate = sdf1.parse(startDateStr)
	def endDate = sdf1.parse(endDateStr)

	// Compare the dates
	def isStartBeforeEnd = startDate.before(endDate)

	// Set the JMeter variable
	vars.put(&quot;flag&quot;, isStartBeforeEnd.toString())
} else {
	vars.put(&quot;flag&quot;, &quot;false&quot;)
}</stringProp>
                </JSR223PostProcessor>
