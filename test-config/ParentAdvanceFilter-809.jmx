            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import java.text.SimpleDateFormat

// Get the input date from JMeter variable
String C_ApptPrefDate = vars.get(&quot;C_ApptPrefDate&quot;)

// Define input and output date formats
SimpleDateFormat inputFormat = new SimpleDateFormat(&quot;MM/dd/yyyy&quot;)
SimpleDateFormat outputFormat = new SimpleDateFormat(&quot;EEE MMM dd yyyy&quot;)

// Parse the input date string to a Date object
Date date = inputFormat.parse(C_ApptPrefDate)

// Format the Date object to the desired output format
String outputDate = outputFormat.format(date)

// Set the converted date to a JMeter variable
vars.put(&quot;outputDate&quot;, outputDate)

// Print the output date string to the JMeter log
log.info(&quot;Converted date: &quot; + outputDate)</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
