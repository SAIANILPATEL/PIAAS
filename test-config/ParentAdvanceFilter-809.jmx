            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="prefDate" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import java.text.SimpleDateFormat
import java.util.Date

// Get the date-time string from the JMeter variable
def dateTimeStr = vars.get(&quot;C_ApptPrefDate&quot;)

// Define the pattern for parsing the date-time string
def pattern = &apos;MM/dd/yyyy HH:mm:ss&apos;

// Create a SimpleDateFormat object with the given pattern
def sdf = new SimpleDateFormat(pattern)

// Parse the date-time string to a Date object
def date = sdf.parse(dateTimeStr)

// Define the pattern for formatting the date in the desired format
def outputPattern = &apos;EEE MMM dd yyyy&apos;

// Create another SimpleDateFormat object for the output format
def outputFormat = new SimpleDateFormat(outputPattern)

// Format the Date object to get the date string in the desired format
def formattedDateStr = outputFormat.format(date)

// Store the formatted date string in a JMeter variable
vars.put(&quot;prefDate&quot;, formattedDateStr)

def vendor = vars.get(&quot;C_VendorId11&quot;)
if (vendor.equals(&quot;C_VendorId11_NF&quot;)){
	vars.put(&quot;C_VendorId11&quot;,&quot;null&quot;)
}



// Log the formatted date (optional)
log.info(&quot;---------------------Formatted Date: &quot; + formattedDateStr)
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
