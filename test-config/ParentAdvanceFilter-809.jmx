                <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="timeStr" enabled="true">
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="script">import java.text.SimpleDateFormat
// Get the date-time string from the JMeter variable
def dateTimeStr = vars.get(&quot;C_StartTime&quot;)

// Define the pattern for parsing the date-time string
def pattern = &apos;MM/dd/yyyy HH:mm:ss&apos;

// Create a SimpleDateFormat object with the given pattern
def sdf = new SimpleDateFormat(pattern)

// Parse the date-time string to a Date object
def date = sdf.parse(dateTimeStr)

// Define the pattern for formatting just the time
def timePattern = &apos;HH:mm:ss&apos;

// Create another SimpleDateFormat object for the time
def timeFormat = new SimpleDateFormat(timePattern)

// Format the Date object to get just the time string
def timeStr = timeFormat.format(date)

// Store the time string in a JMeter variable
vars.put(&quot;timeStr&quot;, timeStr)

// Log the time string (optional)
log.info(&quot;Time: &quot; + timeStr)
</stringProp>
                  <stringProp name="scriptLanguage">groovy</stringProp>
                </JSR223PreProcessor>
