                <hashTree/>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor2" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import java.time.LocalTime;
import java.time.format.DateTimeFormatter;

// Get the start time from JMeter variable
String startTimeString = vars.get(&quot;C_StartTime&quot;);

// Parse start time from string
LocalTime startTime = LocalTime.parse(startTimeString, DateTimeFormatter.ofPattern(&quot;HH:mm:ss&quot;));

// Add 30 minutes
LocalTime endTime = startTime.plusMinutes(30);

// Format end time as string
String formattedEndTime = endTime.format(DateTimeFormatter.ofPattern(&quot;HH:mm:ss&quot;));

// Store formatted end time in JMeter variable
vars.put(&quot;pEndTime&quot;, formattedEndTime);

log.info(&quot;Start Time: &quot; + startTimeString);
log.info(&quot;End Time: &quot; + formattedEndTime);</stringProp>
                </JSR223PostProcessor>
