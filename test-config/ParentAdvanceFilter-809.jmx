                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import java.text.SimpleDateFormat
import java.util.Calendar


def x = vars.get(&quot;loopCount1&quot;) as int
x += 1
vars.put(&apos;loopCount1&apos;, x.toString())

// Get the current date from the JMeter variable
def currentDateStr = vars.get(&quot;newDate&quot;).replaceAll(&apos;&quot;&apos;, &apos;&apos;)

// Define the date format
def sdf = new SimpleDateFormat(&quot;E MMM d yyyy&quot;)

// Parse the current date string to a Date object
def currentDate = sdf.parse(currentDateStr)

// Create a Calendar object and set the current date
def calendar = Calendar.getInstance()
calendar.setTime(currentDate)

// Add one day to the date
calendar.add(Calendar.DAY_OF_MONTH, 1)

// Format the new date back to the desired string format
def newDateStr = sdf.format(calendar.getTime())

// Store the new date in a JMeter variable
vars.put(&quot;newDate&quot;, newDateStr)

// Log the new date (optional)
log.info(&quot;New Date: &quot; + newDateStr)</stringProp>
                </JSR223PostProcessor>
