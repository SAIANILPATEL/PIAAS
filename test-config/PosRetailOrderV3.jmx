                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;GuestSearchList&quot;,&quot;variables&quot;:{&quot;withServiceItemRequestsInfo&quot;:false,&quot;withPersonSearchInfo&quot;:false,&quot;withLoyaltyProgramValueInfo&quot;:false,&quot;search&quot;:&quot;%28cabin.code%3D%3D%22%2a${P_FirstName}%2a%22%20or%20firstNameLastName%3D%3D%22%2a${P_FirstName}%2a%22%20or%20bookingNumber%3D%3D%22%2a${P_FirstName}%2a%22%20or%20groups.code%3D%3D%22%2a${P_FirstName}%2a%22%20or%20groups.description%3D%3D%22%2a${P_FirstName}%2a%22%20or%20personDocuments.documentNr%3D%3D%22%2a${P_FirstName}%2a%22%20or%20externalId%3D%3D%22%2a${P_FirstName}%2a%22%29%20and%20reservationStatus%3Din%3D%28%22CHECKED_IN%22%29%20and%20accountType%3D%3DPAX%20and%20shipId%3D%3D${P_ShipId}&quot;,&quot;page&quot;:0,&quot;size&quot;:25,&quot;hierarchyId&quot;:&quot;${P_rvc_id}&quot;},&quot;query&quot;:&quot;query GuestSearchList($search: String, $page: Int, $size: Int, $sort: String, $hierarchyId: String, $withServiceItemRequestsInfo: Boolean = false, $withPersonSearchInfo: Boolean = false, $withLoyaltyProgramValueInfo: Boolean = false) {\n  pageableAllReservationSearches(\n    search: $search\n    page: $page\n    size: $size\n    sort: $sort\n  ) {\n    totalElements\n    number\n    totalPages\n    content {\n      ...GuestSearch\n      __typename\n    }\n    __typename\n  }\n}\n\nfragment GuestSearch on AllReservationSearch {\n  absenceDetails {\n    absenceEndDate\n    absenceReason\n    absenceStartDate\n    absenceTourDescription\n    absenceTourId\n    currentlyAbsent\n    __typename\n  }\n  accountType\n  activeFrom\n  activeFromTime\n  activeTo\n  activeToTime\n  activityDetails {\n    participateInActivities\n    __typename\n  }\n  actualDisembarkationVoyageDayId\n  actualEmbarkationVoyageDayId\n  age\n  ageGroups {\n    category\n    group\n    __typename\n  }\n  allMemberCount\n  amountNeededToAuthorization\n  authorizationAmount {\n    totalApproveAmount\n    authoriz