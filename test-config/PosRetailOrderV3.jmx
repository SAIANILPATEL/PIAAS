                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;CheckSearchList&quot;,&quot;variables&quot;:{&quot;search&quot;:&quot;%28rvcId%3Din%3D%28%22${P_rvc_id}%22%29%20and%20checkStatus%3Din%3D%28%22CLOSED%22%29%29%20and%20shipId%3D%3D${P_ShipId}&quot;,&quot;page&quot;:0,&quot;size&quot;:20,&quot;sort&quot;:&quot;checkNo%2Cdesc&quot;,&quot;searchPassenger&quot;:&quot;&quot;,&quot;searchBuyer&quot;:&quot;&quot;,&quot;searchEmployee&quot;:&quot;&quot;},&quot;query&quot;:&quot;query CheckSearchList($search: String, $hierarchyId: String, $searchPassenger: String, $searchBuyer: String, $searchEmployee: String, $page: Int, $size: Int, $sort: String) {\n  pageableChecks(\n    search: $search\n    hierarchyId: $hierarchyId\n    searchPassenger: $searchPassenger\n    searchBuyer: $searchBuyer\n    searchEmployee: $searchEmployee\n    page: $page\n    size: $size\n    sort: $sort\n  ) {\n    content {\n      ...CheckSearchItem\n      __typename\n    }\n    totalPages\n    totalElements\n    __typename\n  }\n}\n\nfragment CheckSearchItem on CheckDTO {\n  id\n  checkNo\n  tableNumber\n  openDateTime\n  guestCount\n  total\n  checkStatus\n  statuses {\n    packageSale\n    __typename\n  }\n  employeeId\n  rvcId\n  revenueCenterInfoGql {\n    id\n    translations\n    __typename\n  }\n  buyerInfoGql {\n    id\n    pictureId\n    reservationStatus\n    onboard\n    accountType\n    firstName\n    lastName\n    profileDescription\n    cabin {\n      code\n      __typename\n    }\n    __typename\n  }\n  employeeGql {\n    id\n    firstName\n    lastName\n    __typename\n  }\n  __typename\n}&quot;}</stringProp>
