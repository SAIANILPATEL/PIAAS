  checks(search: $search, hierarchyId: $hierarchyId, sort: $sort) {
    ...ActiveCheckItem
    __typename
  }
}

fragment ActiveCheckItem on CheckDTO {
  id
  checkNo
  checkStatus
  totalDue
  openDateTime
  guestCount
  employeeId
  tableNumber
  checksConsumers {
    pictureId
    __typename
  }
  statuses {
    packageSale
    paymentFailAfterSplitCheck
    __typename
  }
  __typename
}
</stringProp>
