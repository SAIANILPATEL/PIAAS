                <elementProp name="" elementType="HTTPArgument" enabled="true">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;ActiceChecksList&quot;,&quot;variables&quot;:{&quot;hierarchyId&quot;:&quot;${P_rvc_id}&quot;,&quot;search&quot;:&quot;checkStatus%3Din%3D%28OPEN%2CINPROGRESS%29%20and%20status%3Dlike%3D_____________0%25%20and%20employeeId%3D%3D${C_currentUser_id}&quot;,&quot;sort&quot;:&quot;openDateTime%2Cdesc&quot;},&quot;query&quot;:&quot;query ActiceChecksList($search: String, $hierarchyId: String, $sort: String) {\n  checks(search: $search, hierarchyId: $hierarchyId, sort: $sort) {\n    ...ActiveCheckItem\n    __typename\n  }\n}\n\nfragment ActiveCheckItem on CheckDTO {\n  id\n  checkNo\n  checkStatus\n  totalDue\n  openDateTime\n  guestCount\n  employeeId\n  tableNumber\n  checksConsumers {\n    pictureId\n    __typename\n  }\n  statuses {\n    packageSale\n    paymentFailAfterSplitCheck\n    __typename\n  }\n  __typename\n}&quot;}</stringProp>
