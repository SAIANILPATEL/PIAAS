fragment UserItem on User {
  rvcCategories
  inheritedRvcCategories
  groupIds
  allowManualSearch {
    inherited
    value
    __typename
  }
  creationDTTM
  firstName
  lastName
  id
  accountTypes
  inheritedAccountTypes
  userCredentials {
    email
    __typename
  }
  userExpiration {
    effectiveFrom
    effectiveTo
