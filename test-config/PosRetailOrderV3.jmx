            <stringProp name="GraphQLHTTPSampler.operationName">CheckSearchList</stringProp>
            <stringProp name="GraphQLHTTPSampler.query">query CheckSearchList($search: String, $hierarchyId: String, $searchPassenger: String, $searchBuyer: String, $searchEmployee: String, $page: Int, $size: Int, $sort: String) {
  pageableChecks(
    search: $search
    hierarchyId: $hierarchyId
    searchPassenger: $searchPassenger
    searchBuyer: $searchBuyer
    searchEmployee: $searchEmployee
    page: $page
    size: $size
    sort: $sort
  ) {
    content {
      ...CheckSearchItem
      __typename
    }
    totalPages
    totalElements
    __typename
  }
}

fragment CheckSearchItem on CheckDTO {
  id
  checkNo
  tableNumber
  openDateTime
  guestCount
  total
  checkStatus
  statuses {
    packageSale
    __typename
  }
  employeeId
  rvcId
  revenueCenterInfoGql {
    id
    translations
    __typename
  }
  buyerInfoGql {
    id
    pictureId
    reservationStatus
    onboard
    accountType
    firstName
    lastName
    profileDescription
    cabin {
      code
      __typename
    }
    __typename
  }
  employeeGql {
    id
    firstName
    lastName
    __typename
  }
  __typename
}
</stringProp>
