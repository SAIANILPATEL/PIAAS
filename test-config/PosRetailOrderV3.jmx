  pageableChecks(
    search: $search
    hierarchyId: $hierarchyId
    searchPassenger: $searchPassenger
    searchBuyer: $searchBuyer
    searchEmployee: $searchEmployee
    page: $page
    size: $size
    sort: $sort
  ) {
    content {
      ...CheckSearchItem
      __typename
    }
    totalPages
    totalElements
    __typename
  }
}

