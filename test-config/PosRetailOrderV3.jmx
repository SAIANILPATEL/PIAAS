   __typename\n  }\n  specialAssistanceTypes {\n    id\n    __typename\n  }\n  pictureId\n  pictureUrl\n  profile {\n    genderValue(hierarchyId: $hierarchyId) {\n      id\n      code\n      translations\n      __typename\n    }\n    specialAssistances {\n      content {\n        handicapType {\n          code\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    company\n    numberOfCruises\n    salutationGql(hierarchyId: $hierarchyId) {\n      code\n      entityId\n      hierarchyId\n      id\n      translations\n      __typename\n    }\n    titleValue(hierarchyId: $hierarchyId) {\n      code\n      entityId\n      hierarchyId\n      id\n      translations\n      __typename\n    }\n    __typename\n  }\n  postingAllowed\n  postingGrpAccounts {\n    name\n    reservationId\n    shortAccountType\n    __typename\n  }\n  postingStatusComment\n  postingSysAccounts {\n    name\n    reservationId\n    shortAccountType\n    __typename\n  }\n  preferredLanguage\n  priorityBoarding\n  profileCode\n  profileDescription\n  profileId\n  reservationStatus\n  rfiduids\n  routingInfo {\n    paidBy\n    payingFor\n    __typename\n  }\n  safetyNumber\n  scheduledDisembarkationVoyageDayId\n  scheduledEmbarkationVoyageDayId\n  serviceItemRequestsPersonReservationGql @include(if: $withServiceItemRequestsInfo) {\n    id\n    status\n    __typename\n  }\n  shipId\n  systemAccountProfileDetail {\n    categoryGql {\n      translations\n      __typename\n    }\n    iamSecurityLevel\n    enabled\n    __typename\n  }\n  ticketId\n  travelWith\n  userCredentialsId\n  vendorPin\n  visitorId\n  visitorTypeId\n  shipGql {\n    translations\n    __typename\n  }\n  when\n  who\n  __typename\n}&quot;}</stringProp>
